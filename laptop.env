# Memory settings for a computer that can give Docker 8 GB of memory: a
# laptop with 16 GB, or Docker Desktop at its usual allowance. Start the
# dashboard with
#
#     docker compose --env-file laptop.env up --build
#
# and use that same command every time. Loading the full dataset is slower
# with these settings than with the defaults, and nothing else changes.
# (README, Quick start.)
DUCKDB_MEMORY_GB=4
CONTAINER_MEMORY_LIMIT=7g
