# Keep the build context small. Without this, the 24 GB production CSV is
# uploaded to the Docker daemon on every build.
*.csv
*.parquet
!hits_all_models_dummy.parquet

data/
# The drop folder reaches the container through the read-only mount, not the image.
ingest/
# The data download's bookkeeping, and the partial file of an interrupted download.
.cache/
.venv/
.git/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
tests/

# Large artefacts of the batch pipeline; the server does not use them.
dashboard.html
*.png
*.jpg
*.ipynb
