# Settings for `docker compose`. Copy this file to .env and edit it.
# Compose reads .env from this folder by itself; `--env-file laptop.env`
# replaces it, so with that flag set HOST_PORT in the shell
# (HOST_PORT=8123 docker compose --env-file laptop.env up --build) or pass
# both files (--env-file .env --env-file laptop.env).

# The port the dashboard answers on at http://localhost:<port>.
HOST_PORT=8000

# 0 skips the Hugging Face download at start (offline, or files placed by hand).
# HF_SYNC=0
# Comma-separated globs of the dataset's files to download (default: every
# Parquet file of ingest/ and every JSON model of xgboost_models/).
# HF_SYNC_INCLUDE=ingest/hits_all_models.parquet,xgboost_models/*.json
# 1 replaces a local file whose content differs from the dataset's.
# HF_SYNC_OVERWRITE=1
# DuckDB's memory ceiling in GB (default 16; laptop.env sets 4).
# DUCKDB_MEMORY_GB=16
# The container's memory limit, DUCKDB_MEMORY_GB + 4 GB or more (default 20g).
# CONTAINER_MEMORY_LIMIT=20g
