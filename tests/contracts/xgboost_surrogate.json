{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/xgboost?view=surrogate (E4, depth-3 surrogate tree)",
 "type": "object",
 "required": [
  "meta",
  "run",
  "filtered",
  "selection_note",
  "filter",
  "view",
  "task",
  "labels",
  "units",
  "nodes",
  "n_nodes",
  "rule",
  "fidelity",
  "tree",
  "color_domain",
  "notes",
  "label_info",
  "color_by",
  "color_domain_basis",
  "weak_below_n"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "run": {
   "$ref": "#/$defs/run"
  },
  "filtered": {
   "const": false
  },
  "selection_note": {
   "type": "string"
  },
  "filter": {
   "$ref": "#/$defs/filter"
  },
  "view": {
   "const": "surrogate"
  },
  "task": {
   "enum": [
    "momentum",
    "angle"
   ]
  },
  "labels": {
   "type": "array",
   "items": {
    "enum": [
     "momentum",
     "phi",
     "theta"
    ]
   },
   "minItems": 1,
   "maxItems": 2
  },
  "units": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "depth",
     "left",
     "right",
     "leaf",
     "feature",
     "frame",
     "threshold",
     "n",
     "impurity",
     "values",
     "sd",
     "circular"
    ],
    "properties": {
     "id": {
      "type": "integer"
     },
     "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
     },
     "left": {
      "type": [
       "integer",
       "null"
      ]
     },
     "right": {
      "type": [
       "integer",
       "null"
      ]
     },
     "leaf": {
      "type": "boolean"
     },
     "feature": {
      "type": [
       "string",
       "null"
      ]
     },
     "frame": {
      "anyOf": [
       {
        "enum": [
         "absolute",
         "trans",
         "local",
         "none"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "threshold": {
      "type": [
       "number",
       "null"
      ]
     },
     "n": {
      "type": "integer"
     },
     "impurity": {
      "type": [
       "number",
       "null"
      ]
     },
     "values": {
      "type": "object",
      "propertyNames": {
       "enum": [
        "momentum",
        "phi",
        "theta"
       ]
      },
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "sd": {
      "type": "object",
      "propertyNames": {
       "enum": [
        "momentum",
        "phi",
        "theta"
       ]
      },
      "additionalProperties": {
       "type": [
        "number",
        "null"
       ]
      },
      "description": "Each output's within-node SD of the booster's predictions, ddof = 1 (analysis version 3); null for a node of one row. impurity stays sklearn's ddof = 0 variance."
     },
     "circular": {
      "type": "object",
      "propertyNames": {
       "enum": [
        "phi"
       ]
      },
      "additionalProperties": {
       "type": "object",
       "required": [
        "mean",
        "resultant"
       ],
       "properties": {
        "mean": {
         "type": [
          "number",
          "null"
         ]
        },
        "resultant": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0,
         "maximum": 1
        }
       }
      },
      "description": "For an azimuth output: the circular mean and mean resultant length R̄ of the booster's predictions on the node's rows. Empty for a linear output."
     }
    }
   },
   "minItems": 1,
   "maxItems": 15
  },
  "n_nodes": {
   "type": "integer",
   "minimum": 1,
   "maximum": 15
  },
  "rule": {
   "type": "string"
  },
  "fidelity": {
   "type": "object",
   "required": [
    "r2",
    "mae",
    "unit",
    "outputs",
    "against",
    "statement",
    "threshold"
   ],
   "properties": {
    "r2": {
     "type": [
      "number",
      "null"
     ]
    },
    "mae": {
     "type": [
      "number",
      "null"
     ]
    },
    "unit": {
     "type": "string"
    },
    "outputs": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "r2",
       "mae",
       "judged_on",
       "low"
      ],
      "properties": {
       "r2": {
        "type": [
         "number",
         "null"
        ]
       },
       "mae": {
        "type": [
         "number",
         "null"
        ]
       },
       "r2_circular": {
        "type": [
         "number",
         "null"
        ],
        "description": "φ only: 1 − Σ(1 − cos Δ) / Σ(1 − cos(φ − φ̄)), Δ the tree's φ minus the booster's wrapped to (−π, π], φ̄ the booster's circular mean."
       },
       "mae_wrapped": {
        "type": [
         "number",
         "null"
        ],
        "description": "φ only: mean |Δ| in rad."
       },
       "judged_on": {
        "enum": [
         "r2",
         "r2_circular"
        ],
        "description": "The R² the low-fidelity flag is judged on: r2_circular for φ (D-5), r2 otherwise."
       },
       "low": {
        "type": [
         "boolean",
         "null"
        ]
       }
      }
     }
    },
    "against": {
     "type": "string"
    },
    "statement": {
     "type": "string"
    },
    "threshold": {
     "const": 0.5,
     "description": "An output whose judged R² is below this is flagged low fidelity."
    }
   }
  },
  "tree": {
   "type": "object",
   "required": [
    "max_depth",
    "random_state",
    "criterion",
    "n_rows",
    "target"
   ],
   "properties": {
    "max_depth": {
     "const": 3
    },
    "random_state": {
     "const": 42
    },
    "criterion": {
     "type": "string"
    },
    "n_rows": {
     "type": "integer"
    },
    "target": {
     "type": "string"
    }
   }
  },
  "color_domain": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": [
      "number",
      "null"
     ]
    },
    "minItems": 2,
    "maxItems": 2
   },
   "propertyNames": {
    "enum": [
     "momentum",
     "theta"
    ]
   },
   "description": "Per coloured output, [lo, hi] over the nodes of at least weak_below_n rows (D-6); every node's range only when provisional."
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "label_info": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "coloured",
     "reason"
    ],
    "properties": {
     "name": {
      "enum": [
       "momentum",
       "phi",
       "theta"
      ]
     },
     "coloured": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     }
    }
   },
   "minItems": 1,
   "maxItems": 2,
   "description": "Per output, whether nodes may be coloured by its value; φ never is."
  },
  "color_by": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "momentum",
     "phi",
     "theta"
    ]
   },
   "additionalProperties": {
    "type": "boolean"
   },
   "description": "Whether nodes may be coloured by each output's value (label_info gives the reason)."
  },
  "color_domain_basis": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "momentum",
     "theta"
    ]
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "min_n",
     "n_nodes",
     "provisional",
     "n_above",
     "n_below"
    ],
    "properties": {
     "min_n": {
      "type": "integer"
     },
     "n_nodes": {
      "type": "integer",
      "minimum": 0
     },
     "provisional": {
      "type": "boolean"
     },
     "n_above": {
      "type": "integer",
      "minimum": 0
     },
     "n_below": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "description": "How each colour domain was taken, and how many nodes lie beyond it (drawn in the end colour and marked ▲ / ▼)."
  },
  "weak_below_n": {
   "const": 20,
   "description": "A node of fewer rows is weak and sets no colour domain."
  }
 },
 "propertyNames": {
  "not": {
   "enum": [
    "rows",
    "predictions",
    "hits"
   ]
  }
 },
 "$defs": {
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "exact",
    "cached",
    "warnings",
    "view",
    "task"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "exact": {
     "type": "boolean"
    },
    "cached": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "view": {
     "const": "surrogate"
    },
    "task": {
     "enum": [
      "momentum",
      "angle"
     ]
    }
   }
  },
  "split": {
   "type": "object",
   "required": [
    "reproduced",
    "ratio_42",
    "ratio_others",
    "seeds_others",
    "n_others",
    "max_others",
    "seed_of_max",
    "median_others",
    "margin",
    "headroom",
    "rule",
    "warning"
   ],
   "properties": {
    "reproduced": {
     "type": "boolean"
    },
    "ratio_42": {
     "type": [
      "number",
      "null"
     ]
    },
    "ratio_others": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "maxItems": 99,
     "description": "validation / training MSE at each of seeds_others, in that order"
    },
    "seeds_others": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "maxItems": 99,
     "description": "random_state 0 to 99 without 42"
    },
    "n_others": {
     "type": "integer",
     "minimum": 0
    },
    "max_others": {
     "type": [
      "number",
      "null"
     ]
    },
    "seed_of_max": {
     "type": [
      "integer",
      "null"
     ]
    },
    "median_others": {
     "type": [
      "number",
      "null"
     ]
    },
    "margin": {
     "type": "number",
     "minimum": 1
    },
    "headroom": {
     "type": [
      "number",
      "null"
     ]
    },
    "rule": {
     "type": "string"
    },
    "warning": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "description": "Passes when ratio_42 > margin × max_others (calosrv/modelruns/analysis.py SPLIT_MARGIN)."
  },
  "run": {
   "type": "object",
   "required": [
    "species",
    "seed",
    "task",
    "labels",
    "label_units",
    "model_file",
    "sha256",
    "analysis_version",
    "split",
    "xgboost_version",
    "n_rows",
    "n_train",
    "n_holdout",
    "test_size"
   ],
   "properties": {
    "species": {
     "type": "string"
    },
    "seed": {
     "type": "integer"
    },
    "task": {
     "enum": [
      "momentum",
      "angle"
     ]
    },
    "labels": {
     "type": "array",
     "items": {
      "enum": [
       "momentum",
       "phi",
       "theta"
      ]
     },
     "minItems": 1,
     "maxItems": 2
    },
    "label_units": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "model_file": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    },
    "analysis_version": {
     "type": "integer"
    },
    "split": {
     "$ref": "#/$defs/split"
    },
    "xgboost_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "n_rows": {
     "type": "integer"
    },
    "n_train": {
     "type": "integer"
    },
    "n_holdout": {
     "type": "integer"
    },
    "test_size": {
     "type": "number"
    },
    "archive_increasing": {
     "type": [
      "boolean",
      "null"
     ]
    }
   }
  },
  "summary": {
   "type": "object",
   "required": [
    "mean",
    "sd",
    "se",
    "t95",
    "n",
    "dof",
    "t",
    "clipped"
   ],
   "properties": {
    "mean": {
     "type": [
      "number",
      "null"
     ]
    },
    "sd": {
     "type": [
      "number",
      "null"
     ]
    },
    "se": {
     "type": [
      "number",
      "null"
     ]
    },
    "t95": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "n": {
     "type": "integer"
    },
    "dof": {
     "type": [
      "integer",
      "null"
     ]
    },
    "t": {
     "type": [
      "number",
      "null"
     ]
    },
    "clipped": {
     "type": "boolean"
    }
   }
  },
  "t_interval": {
   "type": "object",
   "required": [
    "label",
    "level",
    "dof",
    "t",
    "method"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "level": {
     "type": "number"
    },
    "dof": {
     "type": "integer"
    },
    "t": {
     "type": "number"
    },
    "method": {
     "type": "string"
    }
   }
  }
 }
}
