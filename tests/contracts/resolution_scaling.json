{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/resolution-scaling (σ/E against 1/√E, Page 2 res-scaling)",
 "type": "object",
 "required": [
  "meta",
  "kind",
  "n_events",
  "unit",
  "estimator",
  "axis",
  "gates",
  "anchors",
  "model",
  "series",
  "off_axis",
  "notes",
  "filter"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "kind": {
   "type": "string"
  },
  "n_events": {
   "type": "integer",
   "minimum": 0,
   "description": "Events in the selection (the largest per-shower selection)."
  },
  "unit": {
   "const": "%"
  },
  "estimator": {
   "type": "object",
   "description": "The one estimator this response plots (?estimator=, default median; Martin's decisions, 2026-11-12). The top-level gates are its own; every window's value, ci95, method, se and se_rel are its own, and alt carries the other two.",
   "required": [
    "name",
    "label",
    "quantity",
    "symbol",
    "definition",
    "axis_name",
    "interval",
    "weight",
    "literature",
    "calibration",
    "relation",
    "choices"
   ],
   "properties": {
    "name": {
     "enum": [
      "median",
      "robust",
      "sample"
     ]
    },
    "label": {
     "enum": [
      "Median |rel. err.|",
      "Robust σ (IQR)",
      "Sample σ/μ"
     ]
    },
    "quantity": {
     "enum": [
      "median_error",
      "resolution"
     ]
    },
    "symbol": {
     "enum": [
      "median rel.",
      "σ/E"
     ]
    },
    "definition": {
     "type": "string"
    },
    "axis_name": {
     "enum": [
      "Median |E_est − p| / p [%]",
      "Robust σ/E [%]",
      "σ/E [%]"
     ],
     "description": "axis.y.name and axis.energy.y.name."
    },
    "interval": {
     "type": "object",
     "required": [
      "method",
      "label"
     ],
     "properties": {
      "method": {
       "enum": [
        "bootstrap_percentile",
        "chi2_over_mu"
       ]
      },
      "label": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "weight": {
     "type": "object",
     "required": [
      "method",
      "label"
     ],
     "properties": {
      "method": {
       "enum": [
        "kappa",
        "delta"
       ]
      },
      "label": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "description": "kappa: se = κ·ŷ with κ the window's bootstrap relative SE (median, robust); delta: the delta-method SE of σ/μ (sample)."
    },
    "literature": {
     "type": "object",
     "required": [
      "drawn",
      "warning"
     ],
     "properties": {
      "drawn": {
       "const": true
      },
      "warning": {
       "type": [
        "string",
        "null"
       ],
       "description": "LITERATURE_WARNING under median, null otherwise."
      }
     },
     "additionalProperties": false
    },
    "calibration": {
     "type": "object",
     "required": [
      "rule",
      "label",
      "showers"
     ],
     "properties": {
      "rule": {
       "enum": [
        "median",
        "sum"
       ],
       "description": "median: the deposit is c̃·E_dep, c̃ = 1/median(E_dep/p) over the events with E_dep > 0 (median estimator); sum: c = Σp/ΣE_dep."
      },
      "label": {
       "type": "string"
      },
      "showers": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "a",
         "b"
        ]
       },
       "additionalProperties": {
        "type": "object",
        "required": [
         "c_sum",
         "c_median",
         "n",
         "n_zero_deposit"
        ],
        "properties": {
         "c_sum": {
          "type": [
           "number",
           "null"
          ]
         },
         "c_median": {
          "type": [
           "number",
           "null"
          ],
          "description": "c̃; null without an event with E_dep > 0."
         },
         "n": {
          "type": "integer",
          "minimum": 0
         },
         "n_zero_deposit": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         }
        },
        "additionalProperties": false
       }
      }
     },
     "additionalProperties": false
    },
    "relation": {
     "const": "For unbiased Gaussian errors median|R − 1| = 0.6745·σ/E, so a median relative error is quoted beside σ/E, never converted into it."
    },
    "choices": {
     "const": [
      "median",
      "robust",
      "sample"
     ]
    }
   },
   "additionalProperties": false
  },
  "axis": {
   "type": "object",
   "required": [
    "x",
    "top",
    "y",
    "energy"
   ],
   "properties": {
    "x": {
     "type": "object",
     "required": [
      "min",
      "max",
      "inverse",
      "interval",
      "unit",
      "name"
     ],
     "properties": {
      "min": {
       "const": 0.0
      },
      "max": {
       "const": 0.5
      },
      "inverse": {
       "const": true
      },
      "interval": {
       "type": "number"
      },
      "unit": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "top": {
     "type": "object",
     "required": [
      "name",
      "ticks",
      "rule"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "ticks": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "e_gev",
         "x",
         "label"
        ],
        "properties": {
         "e_gev": {
          "type": [
           "number",
           "null"
          ]
         },
         "x": {
          "type": "number"
         },
         "label": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      "rule": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "y": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "interval",
      "zero_based",
      "provisional",
      "n_clipped",
      "unit",
      "name"
     ],
     "properties": {
      "lo": {
       "const": 0.0
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "zero_based": {
       "const": true
      },
      "provisional": {
       "type": "boolean"
      },
      "n_clipped": {
       "type": "integer",
       "minimum": 0
      },
      "unit": {
       "const": "%"
      },
      "name": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "description": "The 1/√E view's σ/E range, set by the windows alone: those of N ≥ 20 from e_min_gev (whiskers included), else provisionally the weaker windows' markers. No fit sets it; n_clipped counts the windows beyond it."
    },
    "energy": {
     "type": "object",
     "description": "The E view: σ/E against the energy E in GeV, drawn from the same windows and fits at E = 1/x².",
     "required": [
      "x",
      "y",
      "curve_min_gev",
      "y_min_gev",
      "data_max_gev",
      "rule",
      "notes"
     ],
     "properties": {
      "x": {
       "type": "object",
       "required": [
        "min",
        "max",
        "interval",
        "unit",
        "name"
       ],
       "properties": {
        "min": {
         "const": 0.0
        },
        "max": {
         "type": "number",
         "minimum": 80.0,
         "description": "E_VIEW_MAX_GEV, or the dataset's top window edge rounded up to the interval when higher."
        },
        "interval": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "unit": {
         "const": "GeV"
        },
        "name": {
         "type": "string"
        }
       },
       "additionalProperties": false
      },
      "y": {
       "type": "object",
       "required": [
        "lo",
        "hi",
        "interval",
        "zero_based",
        "provisional",
        "n_clipped",
        "unit",
        "name"
       ],
       "properties": {
        "lo": {
         "const": 0.0
        },
        "hi": {
         "type": "number"
        },
        "interval": {
         "type": "number"
        },
        "zero_based": {
         "const": true
        },
        "provisional": {
         "type": "boolean"
        },
        "n_clipped": {
         "type": "integer",
         "minimum": 0
        },
        "unit": {
         "const": "%"
        },
        "name": {
         "type": "string"
        }
       },
       "additionalProperties": false,
       "description": "The E view's own σ/E range, set by the windows alone: those of N ≥ 20 from y_min_gev (whiskers included), else provisionally every window's marker; no fit sets it; windows below y_min_gev only counted in n_clipped."
      },
      "curve_min_gev": {
       "type": "number",
       "description": "No fitted curve is drawn below this energy (E_MIN_GEV)."
      },
      "y_min_gev": {
       "type": "number",
       "description": "A window sets the y range only from this lower edge (E_VIEW_Y_MIN_GEV)."
      },
      "data_max_gev": {
       "type": [
        "number",
        "null"
       ],
       "description": "The bin axis's top edge; null for an empty axis."
      },
      "rule": {
       "type": "string"
      },
      "notes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "gates": {
   "type": "object",
   "required": [
    "report_n",
    "whisker_n",
    "fit_n",
    "e_min_gev",
    "anchor_low_gev",
    "n_anchors",
    "misfit_scale"
   ],
   "properties": {
    "report_n": {
     "enum": [
      2,
      20
     ]
    },
    "whisker_n": {
     "enum": [
      8,
      20
     ]
    },
    "fit_n": {
     "const": 20
    },
    "e_min_gev": {
     "const": 4.0
    },
    "anchor_low_gev": {
     "const": 5.0
    },
    "n_anchors": {
     "const": 3
    },
    "misfit_scale": {
     "const": 5.0,
     "description": "A fit with ndf ≥ 1 and scale_factor above this does not describe its windows (misfit)."
    }
   },
   "additionalProperties": false,
   "description": "report_n, whisker_n and fit_n are the active estimator's: 2 / 8 / 20 under median and sample, 20 / 20 / 20 under robust."
  },
  "anchors": {
   "type": "object",
   "required": [
    "nominal_bins",
    "labels",
    "rule"
   ],
   "properties": {
    "nominal_bins": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "maxItems": 3
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "maxItems": 3
    },
    "rule": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "model": {
   "type": "object",
   "required": [
    "available",
    "source",
    "frame",
    "label",
    "reason",
    "split"
   ],
   "properties": {
    "available": {
     "type": "boolean"
    },
    "source": {
     "enum": [
      "network",
      "xgb",
      null
     ]
    },
    "frame": {
     "enum": [
      "absolute",
      "trans",
      "local",
      null
     ]
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    },
    "reason": {
     "type": [
      "string",
      "null"
     ]
    },
    "split": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "n_selected",
        "n_validation",
        "n_training_excluded",
        "fraction",
        "reproduced"
       ],
       "properties": {
        "n_selected": {
         "type": "integer",
         "minimum": 0
        },
        "n_validation": {
         "type": "integer",
         "minimum": 0
        },
        "n_training_excluded": {
         "type": "integer"
        },
        "fraction": {
         "type": "number"
        },
        "reproduced": {
         "type": "boolean"
        }
       },
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ],
     "description": "XGBoost only: the selection's validation rows against its selected events."
    }
   },
   "additionalProperties": false
  },
  "series": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/series"
   }
  },
  "off_axis": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "series",
     "bins",
     "n"
    ],
    "properties": {
     "series": {
      "type": "string"
     },
     "bins": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "n": {
      "type": "integer",
      "minimum": 0
     }
    },
    "additionalProperties": false
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "additionalProperties": false,
 "$defs": {
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "warnings",
    "coord_system",
    "coord_system_applies",
    "coord_system_note"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "coord_system": {
     "enum": [
      "lab",
      "trans",
      "local"
     ]
    },
    "coord_system_applies": {
     "type": "boolean"
    },
    "coord_system_note": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "window": {
   "type": "object",
   "required": [
    "bin",
    "label",
    "p_lo",
    "p_hi",
    "n",
    "p_mean",
    "x",
    "mean_r",
    "sd_r",
    "value",
    "ci95",
    "method",
    "se",
    "se_rel",
    "se_delta",
    "c4",
    "bias",
    "median_response",
    "tail_share",
    "alt",
    "momentum_spread",
    "dof_note",
    "weak",
    "whisker",
    "eligible",
    "off_axis"
   ],
   "properties": {
    "bin": {
     "type": "integer",
     "description": "The producer's integer momentum bin k: the window [k, k + 1) GeV of the shower's own momentum."
    },
    "label": {
     "type": "string"
    },
    "p_lo": {
     "type": "number"
    },
    "p_hi": {
     "type": "number"
    },
    "n": {
     "type": "integer",
     "minimum": 0,
     "description": "Usable events of the series in the window."
    },
    "p_mean": {
     "type": "number"
    },
    "x": {
     "type": "number",
     "description": "Mean of 1/√p over the window's events, GeV^−1/2: the abscissa."
    },
    "mean_r": {
     "type": [
      "number",
      "null"
     ],
     "description": "Mean of R = E_est / p."
    },
    "sd_r": {
     "type": [
      "number",
      "null"
     ],
     "description": "Sample SD (ddof = 1) of R; null below N = 2."
    },
    "value": {
     "type": [
      "number",
      "null"
     ],
     "description": "The active estimator's value in percent: median |R − 1| (median, from N = 2), IQR(R)/(1.349·median R) (robust, from N = 20, null where median R ≤ 0) or σ/E = 100 sd_r / mean_r (sample, from N = 2, null where mean_r ≤ 0)."
    },
    "ci95": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      {
       "type": "null"
      }
     ],
     "description": "The active estimator's 95% interval in percent, named by method: the median's percentile bootstrap (N ≥ 20) or order-statistic interval (6 ≤ N < 20), the robust width's exact percentile bootstrap, or the χ² interval of σ (N − 1 d.o.f.) divided by μ. The whisker from gates.whisker_n."
    },
    "method": {
     "enum": [
      "bootstrap_percentile",
      "order_statistic",
      "chi2_over_mu",
      null
     ],
     "description": "ci95's method (metrics.METHOD_*); null without an interval."
    },
    "se": {
     "type": [
      "number",
      "null"
     ],
     "description": "The fit weight's SE at the measured value, percent: the SD (ddof = 1) of the bootstrap replicates behind ci95 (median, robust), or the delta-method SE (sample)."
    },
    "se_rel": {
     "type": [
      "number",
      "null"
     ],
     "description": "κ = se / value as a fraction: the relative SE the median and robust fits weight by (se = κ·ŷ); null under sample."
    },
    "se_delta": {
     "type": [
      "number",
      "null"
     ],
     "description": "Sample only: the delta-method SE of σ/μ in percent, the fit weight's basis; null under median and robust."
    },
    "c4": {
     "type": [
      "number",
      "null"
     ],
     "description": "Sample only: bias factor c4(N) of σ, quoted from N = 2 below N = 15; null under median and robust."
    },
    "bias": {
     "type": [
      "number",
      "null"
     ],
     "description": "100 (mean_r − 1): the estimator's own bias, percent."
    },
    "median_response": {
     "type": [
      "number",
      "null"
     ],
     "description": "100 (median R − 1), percent, of this response's R; null below N = 2."
    },
    "tail_share": {
     "type": [
      "number",
      "null"
     ],
     "description": "Percent of events with |R − median R| > 3 IQR(R)/1.349, from N = 20 (a Gaussian gives 0.27%); null below."
    },
    "alt": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "median",
       "robust",
       "sample"
      ]
     },
     "additionalProperties": {
      "type": [
       "number",
       "null"
      ]
     },
     "description": "The two estimators not plotted, in percent: null where not reportable (robust below N = 20, median and sample below N = 2). The deposit's median takes c̃."
    },
    "momentum_spread": {
     "type": [
      "number",
      "null"
     ],
     "description": "100 sd(p)/mean(p) in the window (N ≥ 2)."
    },
    "dof_note": {
     "type": [
      "string",
      "null"
     ],
     "description": "The window's low-N sentence: the sample's d.o.f., N = 1, or under robust the robust floor."
    },
    "weak": {
     "type": "boolean",
     "description": "N < gates.fit_n (20)."
    },
    "whisker": {
     "type": "boolean",
     "description": "N ≥ gates.whisker_n (8, or 20 under robust) and an interval exists: drawn with its whisker."
    },
    "eligible": {
     "type": "boolean",
     "description": "N ≥ gates.fit_n, p_lo ≥ 4 GeV and a positive SE (and κ under median and robust): used by the fits and the y range."
    },
    "off_axis": {
     "type": "boolean",
     "description": "p_lo < 4 GeV: x > 0.5, off the axis."
    }
   },
   "additionalProperties": false
  },
  "fit": {
   "type": "object",
   "required": [
    "form",
    "n_points",
    "ndf",
    "params",
    "chi2",
    "p_value",
    "scale_factor",
    "iterations",
    "converged",
    "curve",
    "provisional",
    "misfit",
    "note"
   ],
   "properties": {
    "form": {
     "enum": [
      "affine",
      "pinned",
      "quadrature"
     ]
    },
    "n_points": {
     "type": "integer",
     "minimum": 1
    },
    "ndf": {
     "type": "integer",
     "minimum": 0,
     "description": "n − p; 0 is allowed and has no χ² test."
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "number",
       "boolean",
       "null"
      ]
     },
     "description": "affine: a (%·√GeV), se_a, b (%), se_b, rho_ab, se_a_stat, se_b_stat; pinned: a0, se_a0, se_a0_stat; quadrature: a, se_a, b (null when B ≤ 0), se_b, b2 (%²), se_b2, b_defined, a2, se_a2, a_defined, se_a_stat, se_b_stat, se_a2_stat, se_b2_stat, rho_a2b2 (the correlation of A and B, null when undefined). SEs are scaled by scale_factor; *_stat are not."
    },
    "chi2": {
     "type": "number"
    },
    "p_value": {
     "type": [
      "number",
      "null"
     ],
     "description": "Upper tail of χ²_ndf; null when ndf = 0."
    },
    "scale_factor": {
     "type": "number",
     "minimum": 1,
     "description": "PDG S = √(χ²/ν) when ν ≥ 1 and χ²/ν > 1, else 1."
    },
    "iterations": {
     "type": "integer",
     "minimum": 0
    },
    "converged": {
     "type": "boolean"
    },
    "negative_intercept": {
