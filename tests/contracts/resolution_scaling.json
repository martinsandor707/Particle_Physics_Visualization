{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/resolution-scaling (σ/E against 1/√E, Page 2 res-scaling)",
 "type": "object",
 "required": [
  "meta",
  "kind",
  "n_events",
  "unit",
  "estimator",
  "axis",
  "gates",
  "anchors",
  "model",
  "series",
  "off_axis",
  "notes",
  "filter"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "kind": {
   "type": "string"
  },
  "n_events": {
   "type": "integer",
   "minimum": 0,
   "description": "Events in the selection (the largest per-shower selection)."
  },
  "unit": {
   "const": "%"
  },
  "estimator": {
   "type": "object",
   "required": [
    "name",
    "definition",
    "label"
   ],
   "properties": {
    "name": {
     "const": "response_ratio"
    },
    "definition": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "axis": {
   "type": "object",
   "required": [
    "x",
    "top",
    "y",
    "energy"
   ],
   "properties": {
    "x": {
     "type": "object",
     "required": [
      "min",
      "max",
      "inverse",
      "interval",
      "unit",
      "name"
     ],
     "properties": {
      "min": {
       "const": 0.0
      },
      "max": {
       "const": 0.5
      },
      "inverse": {
       "const": true
      },
      "interval": {
       "type": "number"
      },
      "unit": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "top": {
     "type": "object",
     "required": [
      "name",
      "ticks",
      "rule"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "ticks": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "e_gev",
         "x",
         "label"
        ],
        "properties": {
         "e_gev": {
          "type": [
           "number",
           "null"
          ]
         },
         "x": {
          "type": "number"
         },
         "label": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      "rule": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "y": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "interval",
      "zero_based",
      "provisional",
      "n_clipped",
      "unit",
      "name"
     ],
     "properties": {
      "lo": {
       "const": 0.0
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "zero_based": {
       "const": true
      },
      "provisional": {
       "type": "boolean"
      },
      "n_clipped": {
       "type": "integer",
       "minimum": 0
      },
      "unit": {
       "const": "%"
      },
      "name": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "energy": {
     "type": "object",
     "description": "The E view: σ/E against the energy E in GeV, drawn from the same windows and fits at E = 1/x².",
     "required": [
      "x",
      "y",
      "curve_min_gev",
      "y_min_gev",
      "data_max_gev",
      "rule",
      "notes"
     ],
     "properties": {
      "x": {
       "type": "object",
       "required": [
        "min",
        "max",
        "interval",
        "unit",
        "name"
       ],
       "properties": {
        "min": {
         "const": 0.0
        },
        "max": {
         "type": "number",
         "minimum": 80.0,
         "description": "E_VIEW_MAX_GEV, or the dataset's top window edge rounded up to the interval when higher."
        },
        "interval": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "unit": {
         "const": "GeV"
        },
        "name": {
         "type": "string"
        }
       },
       "additionalProperties": false
      },
      "y": {
       "type": "object",
       "required": [
        "lo",
        "hi",
        "interval",
        "zero_based",
        "provisional",
        "n_clipped",
        "unit",
        "name"
       ],
       "properties": {
        "lo": {
         "const": 0.0
        },
        "hi": {
         "type": "number"
        },
        "interval": {
         "type": "number"
        },
        "zero_based": {
         "const": true
        },
        "provisional": {
         "type": "boolean"
        },
        "n_clipped": {
         "type": "integer",
         "minimum": 0
        },
        "unit": {
         "const": "%"
        },
        "name": {
         "type": "string"
        }
       },
       "additionalProperties": false,
       "description": "The E view's own σ/E range: windows of N ≥ 20 from y_min_gev (whiskers included) and the non-provisional drawn fits over their fitted spans; windows below y_min_gev only counted in n_clipped."
      },
      "curve_min_gev": {
       "type": "number",
       "description": "No fitted curve is drawn below this energy (E_MIN_GEV)."
      },
      "y_min_gev": {
       "type": "number",
       "description": "A window sets the y range only from this lower edge (E_VIEW_Y_MIN_GEV)."
      },
      "data_max_gev": {
       "type": [
        "number",
        "null"
       ],
       "description": "The bin axis's top edge; null for an empty axis."
      },
      "rule": {
       "type": "string"
      },
      "notes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "gates": {
   "type": "object",
   "required": [
    "report_n",
    "whisker_n",
    "fit_n",
    "e_min_gev",
    "anchor_low_gev",
    "n_anchors"
   ],
   "properties": {
    "report_n": {
     "const": 2
    },
    "whisker_n": {
     "const": 8
    },
    "fit_n": {
     "const": 20
    },
    "e_min_gev": {
     "const": 4.0
    },
    "anchor_low_gev": {
     "const": 5.0
    },
    "n_anchors": {
     "const": 3
    }
   },
   "additionalProperties": false
  },
  "anchors": {
   "type": "object",
   "required": [
    "nominal_bins",
    "labels",
    "rule"
   ],
   "properties": {
    "nominal_bins": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "maxItems": 3
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "maxItems": 3
    },
    "rule": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "model": {
   "type": "object",
   "required": [
    "available",
    "source",
    "frame",
    "label",
    "reason",
    "split"
   ],
   "properties": {
    "available": {
     "type": "boolean"
    },
    "source": {
     "enum": [
      "network",
      "xgb",
      null
     ]
    },
    "frame": {
     "enum": [
      "absolute",
      "trans",
      "local",
      null
     ]
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    },
    "reason": {
     "type": [
      "string",
      "null"
     ]
    },
    "split": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "n_selected",
        "n_validation",
        "n_training_excluded",
        "fraction",
        "reproduced"
       ],
       "properties": {
        "n_selected": {
         "type": "integer",
         "minimum": 0
        },
        "n_validation": {
         "type": "integer",
         "minimum": 0
        },
        "n_training_excluded": {
         "type": "integer"
        },
        "fraction": {
         "type": "number"
        },
        "reproduced": {
         "type": "boolean"
        }
       },
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ],
     "description": "XGBoost only: the selection's validation rows against its selected events."
    }
   },
   "additionalProperties": false
  },
  "series": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/series"
   }
  },
  "off_axis": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "series",
     "bins",
     "n"
    ],
    "properties": {
     "series": {
      "type": "string"
     },
     "bins": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "n": {
      "type": "integer",
      "minimum": 0
     }
    },
    "additionalProperties": false
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "additionalProperties": false,
 "$defs": {
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "warnings",
    "coord_system",
    "coord_system_applies",
    "coord_system_note"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "coord_system": {
     "enum": [
      "lab",
      "trans",
      "local"
     ]
    },
    "coord_system_applies": {
     "type": "boolean"
    },
    "coord_system_note": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "window": {
   "type": "object",
   "required": [
    "bin",
    "label",
    "p_lo",
    "p_hi",
    "n",
    "p_mean",
    "x",
    "mean_r",
    "sd_r",
    "value",
    "ci95",
    "se_delta",
    "c4",
    "bias",
    "momentum_spread",
    "dof_note",
    "weak",
    "whisker",
    "eligible",
    "off_axis"
   ],
   "properties": {
    "bin": {
     "type": "integer",
     "description": "The producer's integer momentum bin k: the window [k, k + 1) GeV of the shower's own momentum."
    },
    "label": {
     "type": "string"
    },
    "p_lo": {
     "type": "number"
    },
    "p_hi": {
     "type": "number"
    },
    "n": {
     "type": "integer",
     "minimum": 0,
     "description": "Usable events of the series in the window."
    },
    "p_mean": {
     "type": "number"
    },
    "x": {
     "type": "number",
     "description": "Mean of 1/√p over the window's events, GeV^−1/2: the abscissa."
    },
    "mean_r": {
     "type": [
      "number",
      "null"
     ],
     "description": "Mean of R = E_est / p."
    },
    "sd_r": {
     "type": [
      "number",
      "null"
     ],
     "description": "Sample SD (ddof = 1) of R; null below N = 2."
    },
    "value": {
     "type": [
      "number",
      "null"
     ],
     "description": "σ/E = 100 sd_r / mean_r in percent; null below N = 2 or where mean_r ≤ 0."
    },
    "ci95": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      {
       "type": "null"
      }
     ],
     "description": "95% χ² interval of σ (N − 1 d.o.f.) divided by μ, percent: the whisker."
    },
    "se_delta": {
     "type": [
      "number",
      "null"
     ],
     "description": "Delta-method SE of σ/μ in percent: the fit weight's basis."
    },
    "c4": {
     "type": [
      "number",
      "null"
     ],
     "description": "Bias factor c4(N) of σ, quoted from N = 2 below N = 15."
    },
    "bias": {
     "type": [
      "number",
      "null"
     ],
     "description": "100 (mean_r − 1): the estimator's own bias, percent."
    },
    "momentum_spread": {
     "type": [
      "number",
      "null"
     ],
     "description": "100 sd(p)/mean(p) in the window (N ≥ 2)."
    },
    "dof_note": {
     "type": [
      "string",
      "null"
     ]
    },
    "weak": {
     "type": "boolean",
     "description": "N < 20."
    },
    "whisker": {
     "type": "boolean",
     "description": "N ≥ 8 and an interval exists: drawn with its whisker."
    },
    "eligible": {
     "type": "boolean",
     "description": "N ≥ 20, p_lo ≥ 4 GeV and a positive SE: used by the fits and the y range."
    },
    "off_axis": {
     "type": "boolean",
     "description": "p_lo < 4 GeV: x > 0.5, off the axis."
    }
   },
   "additionalProperties": false
  },
  "fit": {
   "type": "object",
   "required": [
    "form",
    "n_points",
    "ndf",
    "params",
    "chi2",
    "p_value",
    "scale_factor",
    "iterations",
    "converged",
    "curve",
    "provisional",
    "note"
   ],
   "properties": {
    "form": {
     "enum": [
      "affine",
      "pinned",
      "quadrature"
     ]
    },
    "n_points": {
     "type": "integer",
     "minimum": 1
    },
    "ndf": {
     "type": "integer",
     "minimum": 0,
     "description": "n − p; 0 is allowed and has no χ² test."
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "number",
       "boolean",
       "null"
      ]
     },
     "description": "affine: a (%·√GeV), se_a, b (%), se_b, rho_ab, se_a_stat, se_b_stat; pinned: a0, se_a0, se_a0_stat; quadrature: a, se_a, b (null when B ≤ 0), se_b, b2 (%²), se_b2, b_defined, a2, se_a2, a_defined, se_a_stat, se_b_stat, se_a2_stat, se_b2_stat, rho_a2b2 (the correlation of A and B, null when undefined). SEs are scaled by scale_factor; *_stat are not."
    },
    "chi2": {
     "type": "number"
    },
    "p_value": {
     "type": [
      "number",
      "null"
     ],
     "description": "Upper tail of χ²_ndf; null when ndf = 0."
    },
    "scale_factor": {
     "type": "number",
     "minimum": 1,
     "description": "PDG S = √(χ²/ν) when ν ≥ 1 and χ²/ν > 1, else 1."
    },
    "iterations": {
     "type": "integer",
     "minimum": 0
    },
    "converged": {
     "type": "boolean"
    },
    "negative_intercept": {
     "type": "boolean"
    },
    "band_quantile": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "The band's multiplier on √(gᵀΣg): Student's t₀.₉₇₅,ndf when scale_factor > 1, else z₀.₉₇₅ = 1.96; every form (the quadrature band is taken in z = (σ/E)² and drawn in the E view only)."
    },
    "curve": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        },
        "minItems": 4,
        "maxItems": 4
       },
       "minItems": 2
      },
      {
       "type": "null"
      }
     ],
     "description": "[x, y, lo, hi] in percent from x = 0 to 0.5: the line and its 95% confidence band; null for quadrature (the E view evaluates it from params)."
    },
    "provisional": {
     "type": "boolean"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "mode": {
   "type": "object",
   "required": [
    "points",
    "substitutions",
    "fallback",
    "provisional",
    "affine",
    "pinned",
    "quadrature",
    "span_gev"
   ],
   "properties": {
    "points": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "substitutions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nominal",
       "used",
       "reason"
      ],
      "properties": {
       "nominal": {
        "type": "integer"
       },
       "used": {
        "type": [
         "integer",
         "null"
        ]
       },
       "reason": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    },
    "fallback": {
     "type": "boolean"
    },
    "provisional": {
     "type": "boolean"
    },
    "affine": {
     "anyOf": [
      {
       "$ref": "#/$defs/fit"
      },
      {
       "type": "null"
      }
     ]
    },
    "pinned": {
     "anyOf": [
      {
       "$ref": "#/$defs/fit"
      },
      {
       "type": "null"
      }
     ]
    },
    "quadrature": {
     "anyOf": [
      {
       "$ref": "#/$defs/fit"
      },
      {
       "type": "null"
      }
     ]
    },
    "span_gev": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      {
       "type": "null"
      }
     ],
     "description": "[smallest p_lo, largest p_hi] in GeV of the windows in points: the E view draws the mode's fits solid over it and dashed beyond; null without points."
    }
   },
   "additionalProperties": false
  },
  "series": {
   "type": "object",
   "required": [
    "key",
    "source",
    "shower",
    "shower_label",
    "estimator_label",
    "label",
    "colour_slot",
    "n",
    "n_dropped",
    "n_absent",
    "n_missing",
    "windows",
    "fits"
   ],
   "properties": {
    "key": {
     "type": "string",
     "description": "<source>:<shower>"
    },
    "source": {
     "enum": [
      "detector",
      "network",
      "xgb"
     ]
    },
    "shower": {
     "enum": [
      "a",
      "b"
     ]
    },
    "shower_label": {
     "type": "string"
    },
    "estimator_label": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "colour_slot": {
     "enum": [
      "detector",
      "absolute",
      "trans",
      "local",
      "xgb"
     ]
    },
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "n_dropped": {
     "type": "integer",
     "minimum": 0
    },
    "n_absent": {
     "type": "integer",
     "minimum": 0
    },
    "n_missing": {
     "type": "integer",
     "minimum": 0
    },
    "windows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/window"
     }
    },
    "fits": {
     "type": "object",
     "required": [
      "anchors",
      "all"
     ],
     "properties": {
      "anchors": {
       "$ref": "#/$defs/mode"
      },
      "all": {
       "$ref": "#/$defs/mode"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  }
 }
}
