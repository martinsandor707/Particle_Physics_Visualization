{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/prediction-density",
 "type": "object",
 "required": [
  "meta",
  "network",
  "n_events",
  "axes",
  "density",
  "identity",
  "color",
  "residual",
  "thresholds",
  "notes",
  "filter"
 ],
 "properties": {
  "network": {
   "type": "object",
   "required": [
    "model",
    "frame"
   ],
   "properties": {
    "model": {
     "enum": [
      "energy",
      "angle"
     ]
    },
    "frame": {
     "type": "string"
    }
   }
  },
  "axes": {
   "type": "object",
   "required": [
    "truth",
    "pred"
   ],
   "properties": {
    "truth": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "n",
      "unit",
      "label",
      "zero_based"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "n": {
       "type": "integer"
      },
      "unit": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "zero_based": {
       "type": "boolean"
      }
     }
    },
    "pred": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "n",
      "unit",
      "label",
      "zero_based"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "n": {
       "type": "integer"
      },
      "unit": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "zero_based": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "density": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "a",
     "b"
    ]
   },
   "additionalProperties": {
    "anyOf": [
     {
      "$ref": "#/$defs/counts_block"
     },
     {
      "$ref": "#/$defs/pairs_block"
     }
    ]
   },
   "required": [
    "a",
    "b"
   ]
  },
  "identity": {
   "type": "object",
   "required": [
    "from",
    "to"
   ],
   "properties": {
    "from": {
     "type": "number"
    },
    "to": {
     "type": "number"
    }
   }
  },
  "color": {
   "type": "object",
   "required": [
    "scale",
    "vmin",
    "vmax",
    "unit",
    "empty",
    "palette",
    "ramp",
    "note"
   ],
   "properties": {
    "scale": {
     "const": "log10"
    },
    "vmin": {
     "type": "number"
    },
    "vmax": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "empty": {
     "const": "transparent"
    },
    "palette": {
     "const": "viridis"
    },
    "note": {
     "type": "string"
    },
    "ramp": {
     "type": "object",
     "required": [
      "from",
      "to",
      "stops",
      "first_level"
     ],
     "properties": {
      "from": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "to": {
       "const": 1.0
      },
      "stops": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 2
      },
      "first_level": {
       "type": "object",
       "required": [
        "count",
        "color",
        "contrast",
        "against"
       ],
       "properties": {
        "count": {
         "const": 1
        },
        "color": {
         "type": "string"
        },
        "contrast": {
         "type": "number",
         "minimum": 3
        },
        "against": {
         "const": "#1c2128"
        }
       }
      }
     }
    }
   }
  },
  "residual": {
   "type": "object",
   "required": [
    "quantity",
    "unit",
    "axis",
    "series",
    "excluded"
   ],
   "properties": {
    "quantity": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "axis": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "interval",
      "bins",
      "clipping",
      "provisional",
      "basis",
      "outside",
      "curve_x",
      "hist_centres"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "bins": {
       "type": "integer"
      },
      "clipping": {
       "$ref": "#/$defs/clipping"
      },
      "provisional": {
       "type": "boolean"
      },
      "basis": {
       "type": "string"
      },
      "outside": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "n",
         "below",
         "above"
        ],
        "properties": {
         "n": {
          "type": "integer"
         },
         "below": {
          "type": "integer"
         },
         "above": {
          "type": "integer"
         }
        }
       }
      },
      "curve_x": {
       "type": "array",
       "items": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "hist_centres": {
       "type": "array",
       "items": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    },
    "series": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "a",
       "b"
      ]
     },
     "required": [
      "a",
      "b"
     ],
     "additionalProperties": {
      "type": "object",
      "required": [
       "key",
       "label",
       "shower",
       "kind",
       "slice",
       "fit",
       "draw",
       "drives_scale",
       "estimator",
       "histogram",
       "curve",
       "curve_peak",
       "strip",
       "markers",
       "message",
       "estimates"
      ],
      "properties": {
       "draw": {
        "enum": [
         "histogram",
         "curve+strip",
         "strip"
        ]
       },
       "drives_scale": {
        "type": "boolean"
       },
       "fit": {
        "type": "object"
       },
       "histogram": {
        "type": [
         "object",
         "null"
        ]
       },
       "strip": {
        "type": "object",
        "required": [
         "values",
         "n_shown",
         "truncated"
        ]
       },
       "markers": {
        "type": [
         "object",
         "null"
        ]
       },
       "estimates": {
        "type": "object",
        "required": [
         "bias",
         "sigma",
         "rmse"
        ],
        "properties": {
         "bias": {
          "type": "object",
          "required": [
           "value",
           "se",
           "interval",
           "n",
           "note"
          ],
          "properties": {
           "value": {
            "type": [
             "number",
             "null"
            ]
           },
           "se": {
            "type": [
             "number",
             "null"
            ]
           },
           "interval": {
            "anyOf": [
             {
              "$ref": "#/$defs/interval"
             },
             {
              "type": "null"
             }
            ]
           },
           "n": {
            "type": "integer"
           },
           "note": {
            "type": "string"
           }
          }
         },
         "sigma": {
          "type": "object",
          "required": [
           "value",
           "se",
           "interval",
           "n",
           "note"
          ],
          "properties": {
           "value": {
            "type": [
             "number",
             "null"
            ]
           },
           "se": {
            "type": [
             "number",
             "null"
            ]
           },
           "interval": {
            "anyOf": [
             {
              "$ref": "#/$defs/interval"
             },
             {
              "type": "null"
             }
            ]
           },
           "n": {
            "type": "integer"
           },
           "note": {
            "type": "string"
           }
          }
         },
         "rmse": {
          "type": "object",
          "required": [
           "value",
           "se",
           "interval",
           "n",
           "note"
          ],
          "properties": {
           "value": {
            "type": [
             "number",
             "null"
            ]
           },
           "se": {
            "type": [
             "number",
             "null"
            ]
           },
           "interval": {
            "anyOf": [
             {
              "$ref": "#/$defs/interval"
             },
             {
              "type": "null"
             }
            ]
           },
           "n": {
            "type": "integer"
           },
           "note": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    },
    "excluded": {
     "type": "object",
     "required": [
      "nonpositive_truth"
     ]
    }
   }
  },
  "thresholds": {
   "type": "object",
   "required": [
    "moment",
    "curve",
    "histogram",
    "core",
    "robust",
    "density2d"
   ],
   "properties": {
    "moment": {
     "type": "integer"
    },
    "curve": {
     "type": "integer"
    },
    "histogram": {
     "type": "integer"
    },
    "core": {
     "type": "integer"
    },
    "robust": {
     "type": "integer"
    },
    "density2d": {
     "type": "integer"
    }
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  },
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "n_events": {
   "type": "integer"
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "exact",
    "cached",
    "warnings",
    "model",
    "coord_system"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "exact": {
     "type": "boolean"
    },
    "cached": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "model": {
     "enum": [
      "energy",
      "angle"
     ]
    },
    "coord_system": {
     "enum": [
      "lab",
      "trans",
      "local"
     ]
    }
   }
  },
  "counts_block": {
   "type": "object",
   "required": [
    "encoding",
    "shape",
    "counts",
    "n",
    "n_in_range",
    "max_count",
    "outside"
   ],
   "properties": {
    "encoding": {
     "const": "counts"
    },
    "shape": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "counts": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "n": {
     "type": "integer"
    },
    "n_in_range": {
     "type": "integer"
    },
    "max_count": {
     "type": "integer"
    },
    "outside": {
     "type": "object",
     "required": [
      "truth_below",
      "truth_above",
      "pred_below",
      "pred_above",
      "total"
     ],
     "properties": {
      "truth_below": {
       "type": "integer"
      },
      "truth_above": {
       "type": "integer"
      },
      "pred_below": {
       "type": "integer"
      },
      "pred_above": {
       "type": "integer"
      },
      "total": {
       "type": "integer"
      }
     }
    }
   }
  },
  "pairs_block": {
   "type": "object",
   "required": [
    "encoding",
    "pairs",
    "n",
    "n_in_range",
    "outside"
   ],
   "properties": {
    "encoding": {
     "const": "pairs"
    },
    "pairs": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "maxItems": 14
    },
    "n": {
     "type": "integer"
    },
    "n_in_range": {
     "type": "integer"
    },
    "outside": {
     "type": "object",
     "required": [
      "truth_below",
      "truth_above",
      "pred_below",
      "pred_above",
      "total"
     ],
     "properties": {
      "truth_below": {
       "type": "integer"
      },
      "truth_above": {
       "type": "integer"
      },
      "pred_below": {
       "type": "integer"
      },
      "pred_above": {
       "type": "integer"
      },
      "total": {
       "type": "integer"
      }
     }
    }
   }
  }
 }
}
