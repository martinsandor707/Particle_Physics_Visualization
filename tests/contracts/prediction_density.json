{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/prediction-density; on an aggregate experiment, the XGBoost validation-split series",
 "type": "object",
 "required": [
  "meta",
  "network",
  "n_events",
  "axes",
  "density",
  "identity",
  "color",
  "residual",
  "thresholds",
  "notes",
  "filter"
 ],
 "properties": {
  "network": {
   "type": "object",
   "required": [
    "model",
    "frame"
   ],
   "properties": {
    "model": {
     "enum": [
      "energy",
      "angle"
     ]
    },
    "frame": {
     "type": "string"
    },
    "source": {
     "const": "xgb"
    },
    "label": {
     "enum": [
      "momentum",
      "theta",
      "phi"
     ]
    }
   }
  },
  "axes": {
   "type": "object",
   "required": [
    "truth",
    "pred"
   ],
   "properties": {
    "truth": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "n",
      "unit",
      "label",
      "zero_based"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "n": {
       "type": "integer"
      },
      "unit": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "zero_based": {
       "type": "boolean"
      },
      "circular": {
       "const": true
      }
     }
    },
    "pred": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "n",
      "unit",
      "label",
      "zero_based"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "n": {
       "type": "integer"
      },
      "unit": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "zero_based": {
       "type": "boolean"
      },
      "circular": {
       "const": true
      }
     }
    }
   }
  },
  "density": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "a",
     "b"
    ]
   },
   "additionalProperties": {
    "anyOf": [
     {
      "$ref": "#/$defs/counts_block"
     },
     {
      "$ref": "#/$defs/pairs_block"
     }
    ]
   },
   "required": [
    "a"
   ],
   "description": "Shower B is present on two-shower data; the XGBoost series has one shower."
  },
  "identity": {
   "type": "object",
   "required": [
    "from",
    "to"
   ],
   "properties": {
    "from": {
     "type": "number"
    },
    "to": {
     "type": "number"
    }
   }
  },
  "color": {
   "type": "object",
   "required": [
    "scale",
    "vmin",
    "vmax",
    "unit",
    "empty",
    "palette",
    "ramp",
    "note"
   ],
   "properties": {
    "scale": {
     "const": "log10"
    },
    "vmin": {
     "type": "number"
    },
    "vmax": {
     "type": "number",
     "description": "log10 of the largest count, at least log10 2 whenever a counts encoding is present, so the scale never collapses to vmin = vmax."
    },
    "unit": {
     "type": "string"
    },
    "empty": {
     "const": "transparent"
    },
    "palette": {
     "enum": [
      "viridis",
      "cividis",
      "plasma",
      "turbo"
     ],
     "description": "The default palette that `ramp` describes; ramp.by_palette measures every offered sequential palette."
    },
    "note": {
     "type": "string"
    },
    "ramp": {
     "type": "object",
     "required": [
      "from",
      "to",
      "stops",
      "first_level",
      "min_stop_contrast",
      "clears_everywhere",
      "by_palette"
     ],
     "properties": {
      "from": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "to": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "stops": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 2
      },
      "first_level": {
       "type": "object",
       "required": [
        "count",
        "color",
        "contrast",
        "against"
       ],
       "properties": {
        "count": {
         "const": 1
        },
        "color": {
         "type": "string"
        },
        "contrast": {
         "type": "number",
         "minimum": 3
        },
        "against": {
         "const": "#1c2128"
        }
       }
      },
      "min_stop_contrast": {
       "type": "number",
       "description": "Lowest contrast of any stop against the card."
      },
      "clears_everywhere": {
       "type": "boolean",
       "description": "Every stop is at least 3:1 against the card."
      },
      "by_palette": {
       "type": "object",
       "required": [
        "viridis",
        "cividis",
        "plasma",
        "turbo"
       ],
       "description": "Measured start, stops and first-level colour of each sequential palette the interface offers.",
       "additionalProperties": false,
       "properties": {
        "viridis": {
         "type": "object",
         "required": [
          "from",
          "to",
          "stops",
          "first_level",
          "min_stop_contrast",
          "clears_everywhere"
         ],
         "properties": {
          "from": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "to": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "stops": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 2
          },
          "first_level": {
           "type": "object",
           "required": [
            "count",
            "color",
            "contrast",
            "against"
           ],
           "properties": {
            "count": {
             "const": 1
            },
            "color": {
             "type": "string"
            },
            "contrast": {
             "type": "number",
             "minimum": 3
            },
            "against": {
             "const": "#1c2128"
            }
           }
          },
          "min_stop_contrast": {
           "type": "number",
           "description": "Lowest contrast of any stop against the card."
          },
          "clears_everywhere": {
           "type": "boolean",
           "description": "Every stop is at least 3:1 against the card."
          }
         }
        },
        "cividis": {
         "type": "object",
         "required": [
          "from",
          "to",
          "stops",
          "first_level",
          "min_stop_contrast",
          "clears_everywhere"
         ],
         "properties": {
          "from": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "to": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "stops": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 2
          },
          "first_level": {
           "type": "object",
           "required": [
            "count",
            "color",
            "contrast",
            "against"
           ],
           "properties": {
            "count": {
             "const": 1
            },
            "color": {
             "type": "string"
            },
            "contrast": {
             "type": "number",
             "minimum": 3
            },
            "against": {
             "const": "#1c2128"
            }
           }
          },
          "min_stop_contrast": {
           "type": "number",
           "description": "Lowest contrast of any stop against the card."
          },
          "clears_everywhere": {
           "type": "boolean",
           "description": "Every stop is at least 3:1 against the card."
          }
         }
        },
        "plasma": {
         "type": "object",
         "required": [
          "from",
          "to",
          "stops",
          "first_level",
          "min_stop_contrast",
          "clears_everywhere"
         ],
         "properties": {
          "from": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "to": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "stops": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 2
          },
          "first_level": {
           "type": "object",
           "required": [
            "count",
            "color",
            "contrast",
            "against"
           ],
           "properties": {
            "count": {
             "const": 1
            },
            "color": {
             "type": "string"
            },
            "contrast": {
             "type": "number",
             "minimum": 3
            },
            "against": {
             "const": "#1c2128"
            }
           }
          },
          "min_stop_contrast": {
           "type": "number",
           "description": "Lowest contrast of any stop against the card."
          },
          "clears_everywhere": {
           "type": "boolean",
           "description": "Every stop is at least 3:1 against the card."
          }
         }
        },
        "turbo": {
         "type": "object",
         "required": [
          "from",
          "to",
          "stops",
          "first_level",
          "min_stop_contrast",
          "clears_everywhere"
         ],
         "properties": {
          "from": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "to": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "stops": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 2
          },
          "first_level": {
           "type": "object",
           "required": [
            "count",
            "color",
            "contrast",
            "against"
           ],
           "properties": {
            "count": {
             "const": 1
            },
            "color": {
             "type": "string"
            },
            "contrast": {
             "type": "number",
             "minimum": 3
            },
            "against": {
             "const": "#1c2128"
            }
           }
          },
          "min_stop_contrast": {
           "type": "number",
           "description": "Lowest contrast of any stop against the card."
          },
          "clears_everywhere": {
           "type": "boolean",
           "description": "Every stop is at least 3:1 against the card."
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "residual": {
   "anyOf": [
    {
     "$ref": "#/$defs/residual_linear"
    },
    {
     "$ref": "#/$defs/residual_circular"
    }
   ],
   "description": "linear for energy and θ; circular for the XGBoost φ residual (statistics)."
  },
  "thresholds": {
   "type": "object",
   "required": [
    "moment",
    "curve",
    "histogram",
    "core",
    "robust",
    "density2d"
   ],
   "properties": {
    "moment": {
     "type": "integer"
    },
    "curve": {
     "type": "integer"
    },
    "histogram": {
     "type": "integer"
    },
    "core": {
     "type": "integer"
    },
    "robust": {
     "type": "integer"
    },
    "density2d": {
     "type": "integer"
    }
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  },
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "n_events": {
   "type": "integer"
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "source": {
   "const": "xgb"
  },
  "labels": {
   "type": "array",
   "items": {
    "enum": [
     "momentum",
     "theta",
     "phi"
    ]
   },
   "minItems": 1,
   "maxItems": 2
  },
  "n_selected": {
   "type": "integer"
  },
  "split": {
   "$ref": "#/$defs/xgb_split"
  },
  "run": {
   "$ref": "#/$defs/xgb_run"
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "exact",
    "cached",
    "warnings",
    "model",
    "coord_system"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "exact": {
     "type": "boolean"
    },
    "cached": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "model": {
     "enum": [
      "energy",
      "angle"
     ]
    },
    "coord_system": {
     "enum": [
      "lab",
      "trans",
      "local"
     ]
    },
    "source": {
     "const": "xgb"
    },
    "label": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "momentum",
      "theta",
      "phi",
      null
     ]
    }
   }
  },
  "counts_block": {
   "type": "object",
   "required": [
    "encoding",
    "shape",
    "counts",
    "n",
    "n_in_range",
    "max_count",
    "outside",
    "n_missing"
   ],
   "properties": {
    "encoding": {
     "const": "counts"
    },
    "shape": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "counts": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "n": {
     "type": "integer"
    },
    "n_in_range": {
     "type": "integer"
    },
    "max_count": {
     "type": "integer"
    },
    "outside": {
     "type": "object",
     "required": [
      "truth_below",
      "truth_above",
      "pred_below",
      "pred_above",
      "total"
     ],
     "properties": {
      "truth_below": {
       "type": "integer"
      },
      "truth_above": {
       "type": "integer"
      },
      "pred_below": {
       "type": "integer"
      },
      "pred_above": {
       "type": "integer"
      },
      "total": {
       "type": "integer"
      }
     }
    },
    "n_missing": {
     "type": "object",
     "required": [
      "total",
      "prediction",
      "truth"
     ],
     "description": "Selected events this shower lost for a prediction or truth that is not finite (counted, never zero-filled): the total and each cause.",
     "properties": {
      "total": {
       "type": "integer",
       "minimum": 0
      },
      "prediction": {
       "type": "integer",
       "minimum": 0
      },
      "truth": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  },
  "pairs_block": {
   "type": "object",
   "required": [
    "encoding",
    "pairs",
    "n",
    "n_in_range",
    "outside",
    "n_missing"
   ],
   "properties": {
    "encoding": {
     "const": "pairs"
    },
    "pairs": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "maxItems": 14
    },
    "n": {
     "type": "integer"
    },
    "n_in_range": {
     "type": "integer"
    },
    "outside": {
     "type": "object",
     "required": [
      "truth_below",
      "truth_above",
      "pred_below",
      "pred_above",
      "total"
     ],
     "properties": {
      "truth_below": {
       "type": "integer"
      },
      "truth_above": {
       "type": "integer"
      },
      "pred_below": {
       "type": "integer"
      },
      "pred_above": {
       "type": "integer"
      },
      "total": {
       "type": "integer"
      }
     }
    },
    "n_missing": {
     "type": "object",
     "required": [
      "total",
      "prediction",
      "truth"
     ],
     "description": "Selected events this shower lost for a prediction or truth that is not finite (counted, never zero-filled): the total and each cause.",
     "properties": {
      "total": {
       "type": "integer",
       "minimum": 0
      },
      "prediction": {
       "type": "integer",
       "minimum": 0
      },
      "truth": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  },
  "xgb_split": {
   "type": "object",
   "required": [
    "n_selected",
    "n_validation",
    "n_training_excluded",
    "fraction",
    "rule",
    "reproduced"
   ],
   "properties": {
    "n_selected": {
     "type": "integer"
    },
    "n_validation": {
     "type": "integer"
    },
    "n_training_excluded": {
     "type": "integer"
    },
    "fraction": {
     "type": "number"
    },
    "rule": {
     "type": "string"
    },
    "reproduced": {
     "type": "boolean"
    }
   }
  },
  "xgb_run": {
   "type": "object",
   "required": [
    "species",
    "seed",
    "task",
    "labels",
    "model_file",
    "sha256",
    "analysis_version",
    "split"
   ],
   "properties": {
    "species": {
     "type": "string"
    },
    "seed": {
     "type": "integer"
    },
    "task": {
     "enum": [
      "momentum",
      "angle"
     ]
    },
    "model_file": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    },
    "split": {
     "type": "object",
     "required": [
      "reproduced",
      "ratio_42",
      "ratio_others",
      "warning"
     ]
    }
   }
  },
  "circular_summary": {
   "type": "object",
   "required": [
    "n",
    "unit",
    "mean_direction",
    "mean_direction_se",
    "mean_direction_interval",
    "resultant",
    "circular_sd",
    "rayleigh_p",
    "definition",
    "note"
   ],
   "properties": {
    "n": {
     "type": "integer"
    },
    "unit": {
     "const": "mrad"
    },
    "mean_direction": {
     "type": [
      "number",
      "null"
     ]
    },
    "mean_direction_se": {
     "type": [
      "number",
      "null"
     ]
    },
    "mean_direction_interval": {
     "anyOf": [
      {
       "$ref": "#/$defs/interval"
      },
      {
       "type": "null"
      }
     ]
    },
    "resultant": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 1
    },
    "circular_sd": {
     "type": [
      "number",
      "null"
     ]
    },
    "rayleigh_p": {
     "type": [
      "number",
      "null"
     ]
    },
    "definition": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "core_fit": {
   "type": "object",
   "required": [
    "mu",
    "sigma",
    "n",
    "unit",
    "label"
   ],
   "properties": {
    "mu": {
     "type": [
      "number",
      "null"
     ]
    },
    "sigma": {
     "type": [
      "number",
      "null"
     ]
    },
    "n": {
     "type": "integer"
    },
    "unit": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "residual_linear": {
   "type": "object",
   "required": [
    "quantity",
    "unit",
    "axis",
    "series",
    "excluded",
    "statistics"
   ],
   "properties": {
    "quantity": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "axis": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "interval",
