{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/event?format=voxels",
 "description": "One event as cubes. The voxels block is one of three regime shapes (cells: lab and trans, placed through geometry.axes; local and canonical: sub-deposit splats placed through geometry.grid), and scale one of four ramp shapes (log10 energy density with its floor and degenerate flag; linear [0, 1]; signed linear [-1, +1] with its zero code; categorical species). No object at any depth may carry a 'hits' or 'points' key.",
 "type": "object",
 "required": [
  "meta",
  "event",
  "coordinates",
  "window",
  "footprint_mm",
  "voxels",
  "filter"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "event": {
   "$ref": "#/$defs/event"
  },
  "coordinates": {
   "type": "object",
   "required": [
    "source",
    "residual_max_mm",
    "tolerance_mm",
    "within_tolerance",
    "note"
   ],
   "properties": {
    "source": {
     "enum": [
      "file",
      "computed",
      "lattice"
     ]
    },
    "residual_max_mm": {
     "type": [
      "number",
      "null"
     ]
    },
    "tolerance_mm": {
     "type": "number"
    },
    "within_tolerance": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "note": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "window": {
   "type": "object",
   "required": [
    "half_mm",
    "percentiles",
    "min_half_mm",
    "axes",
    "rule"
   ],
   "properties": {
    "half_mm": {
     "type": "number"
    },
    "percentiles": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     },
     "minItems": 2,
     "maxItems": 2
    },
    "min_half_mm": {
     "type": "number"
    },
    "rule": {
     "type": "string"
    },
    "axes": {
     "type": "object",
     "required": [
      "x",
      "y",
      "z"
     ],
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "footprint_mm": {
   "$ref": "#/$defs/triple"
  },
  "voxels": {
   "anyOf": [
    {
     "$ref": "#/$defs/voxels_cells"
    },
    {
     "$ref": "#/$defs/voxels_local"
    },
    {
     "$ref": "#/$defs/voxels_canonical"
    }
   ]
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "propertyNames": {
  "$ref": "#/$defs/no_raw_keys"
 },
 "$defs": {
  "no_raw_keys": {
   "not": {
    "enum": [
     "hits",
     "points"
    ]
   }
  },
  "triple": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "pair": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "strings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "notice": {
   "type": "object",
   "required": [
    "scope",
    "text"
   ],
   "properties": {
    "scope": {
     "enum": [
      "event",
      "budget"
     ]
    },
    "text": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   },
   "additionalProperties": false
  },
  "cam": {
   "type": "object",
   "required": [
    "column",
    "model",
    "network_frame",
    "normalisation",
    "aggregation",
    "note"
   ],
   "properties": {
    "column": {
     "type": "string"
    },
    "model": {
     "enum": [
      "angle",
      "energy",
      "segmentation"
     ]
    },
    "network_frame": {
     "type": "string"
    },
    "normalisation": {
     "enum": [
      "event",
      "shower"
     ]
    },
    "aggregation": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "exact",
    "query_ms",
    "total_ms",
    "cached",
    "warnings",
    "event",
    "format",
    "shower",
    "frame",
    "channel",
    "model",
    "coordinates",
    "cam",
    "notices"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "exact": {
     "type": "boolean"
    },
    "query_ms": {
     "type": "number"
    },
    "total_ms": {
     "type": "number"
    },
    "cached": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "event": {
     "type": "integer"
    },
    "format": {
     "const": "voxels"
    },
    "shower": {
     "enum": [
      "a",
      "b",
      "both"
     ]
    },
    "frame": {
     "enum": [
      "lab",
      "trans",
      "local",
      "canonical"
     ]
    },
    "channel": {
     "enum": [
      "energy",
      "gradcam",
      "shapcam",
      "segerr",
      "species"
     ]
    },
    "model": {
     "enum": [
      "angle",
      "energy",
      "segmentation",
      null
     ]
    },
    "coordinates": {
     "enum": [
      "file",
      "computed"
     ]
    },
    "cam": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/cam"
      }
     ]
    },
    "notices": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/notice"
     },
     "minItems": 1
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "shower": {
   "type": "object",
   "required": [
    "key",
    "label",
    "n_hits",
    "energy_gev",
    "momentum_gev",
    "theta",
    "phi",
    "theta_deg",
    "phi_deg",
    "p0",
    "first_layer_z",
    "direction"
   ],
   "properties": {
    "key": {
     "enum": [
      "a",
      "b"
     ]
    },
    "label": {
     "type": "string"
    },
    "n_hits": {
     "type": "integer"
    },
    "energy_gev": {
     "type": "number"
    },
    "momentum_gev": {
     "type": [
      "number",
      "null"
     ]
    },
    "theta": {
     "type": [
      "number",
      "null"
     ]
    },
    "phi": {
     "type": [
      "number",
      "null"
     ]
    },
    "theta_deg": {
     "type": [
      "number",
      "null"
     ]
    },
    "phi_deg": {
     "type": [
      "number",
      "null"
     ]
    },
    "p0": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 3,
     "maxItems": 3
    },
    "first_layer_z": {
     "type": [
      "number",
      "null"
     ]
    },
    "direction": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
      }
     ]
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "event": {
   "type": "object",
   "required": [
    "event_number",
    "in_selection",
    "prev",
    "next",
    "n_hits",
    "n_cells",
    "d",
    "e1",
    "e2",
    "overlap",
    "shower",
    "showers"
   ],
   "properties": {
    "event_number": {
     "type": "integer"
    },
    "in_selection": {
     "type": "boolean"
    },
    "prev": {
     "type": [
      "integer",
      "null"
     ]
    },
    "next": {
     "type": [
      "integer",
      "null"
     ]
    },
    "n_hits": {
     "type": "integer"
    },
    "n_cells": {
     "type": "integer"
    },
    "d": {
     "type": [
      "number",
      "null"
     ]
    },
    "e1": {
     "type": [
      "number",
      "null"
     ]
    },
    "e2": {
     "type": [
      "number",
      "null"
     ]
    },
    "overlap": {
     "type": [
      "integer",
      "null"
     ]
    },
    "shower": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/shower"
      }
     ]
    },
    "showers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/shower"
     },
     "minItems": 1,
     "maxItems": 2
    },
    "n_primary_cells": {
     "type": "integer"
    },
    "primary_species": {
     "type": [
      "string",
      "null"
     ]
    },
    "primary_note": {
     "type": "string"
    },
    "d_frame": {
     "type": "object",
     "required": [
      "anchor",
      "entry_a",
      "entry_b",
      "d_entry_mm",
      "psi",
      "z_front_mm",
      "ill_conditioned"
     ],
     "properties": {
      "anchor": {
       "type": "string"
      },
      "entry_a": {
       "$ref": "#/$defs/pair"
      },
      "entry_b": {
       "$ref": "#/$defs/pair"
      },
      "d_entry_mm": {
       "type": "number",
       "minimum": 0
      },
      "psi": {
       "type": "number"
      },
      "z_front_mm": {
       "type": "number"
      },
      "ill_conditioned": {
       "type": "boolean"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "lattice_axis": {
   "type": "object",
   "required": [
    "i0",
    "coords"
   ],
   "properties": {
    "i0": {
     "type": "integer",
     "minimum": 0
    },
    "coords": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 1
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "splat": {
   "type": "object",
   "required": [
    "k",
    "k_z",
    "footprint_mm"
   ],
   "properties": {
    "k": {
     "type": "integer",
     "minimum": 2
    },
    "k_z": {
     "type": "integer",
     "minimum": 1
    },
    "footprint_mm": {
     "$ref": "#/$defs/triple"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   }
  },
  "geometry_cells": {
   "type": "object",
   "required": [
    "cube_mm",
    "axes",
    "coords_rounding_mm",
    "origin_mm",
    "grid",
    "splat",
    "depth",
    "note"
   ],
   "properties": {
    "cube_mm": {
     "$ref": "#/$defs/triple"
    },
    "axes": {
     "type": "object",
     "required": [
      "x",
      "y",
      "z"
     ],
     "properties": {
      "x": {
       "$ref": "#/$defs/lattice_axis"
      },
      "y": {
       "$ref": "#/$defs/lattice_axis"
      },
      "z": {
       "$ref": "#/$defs/lattice_axis"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     },
     "additionalProperties": false
    },
    "coords_rounding_mm": {
     "type": "number"
    },
    "origin_mm": {
     "$ref": "#/$defs/triple"
    },
    "grid": {
     "type": "null"
    },
    "splat": {
     "type": "null"
    },
    "depth": {
     "type": "object",
     "required": [
      "policy",
      "note"
     ],
     "properties": {
      "policy": {
       "const": "native_layers"
      },
      "note": {
       "type": "string"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "note": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   },
   "additionalProperties": false
  },
  "geometry_local": {
   "type": "object",
   "required": [
    "cube_mm",
    "axes",
    "coords_rounding_mm",
    "origin_mm",
    "grid",
    "splat",
    "depth",
    "note"
   ],
   "properties": {
    "cube_mm": {
     "$ref": "#/$defs/triple"
    },
    "axes": {
     "type": "null"
    },
    "coords_rounding_mm": {
     "type": "null"
    },
    "origin_mm": {
     "$ref": "#/$defs/triple"
    },
    "grid": {
     "type": "object",
     "required": [
      "x0",
      "y0",
      "z0",
      "pitch_mm",
      "pitch_z_mm",
      "n",
      "z_axis"
     ],
     "properties": {
      "x0": {
       "type": "number"
      },
      "y0": {
       "type": "number"
      },
      "z0": {
       "type": "number"
      },
      "pitch_mm": {
       "type": "number",
       "minimum": 1
      },
      "pitch_z_mm": {
       "type": "number",
       "minimum": 1
      },
      "n": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1
       },
       "minItems": 3,
       "maxItems": 3
      },
      "z_axis": {
       "const": "uniform"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "splat": {
     "$ref": "#/$defs/splat"
    },
    "depth": {
     "type": "object",
     "required": [
      "policy",
      "note"
     ],
     "properties": {
      "policy": {
       "const": "uniform_bins"
      },
      "note": {
       "type": "string"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "note": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   },
   "additionalProperties": false
  },
  "geometry_canonical": {
   "type": "object",
   "required": [
    "cube_mm",
    "axes",
    "coords_rounding_mm",
    "origin_mm",
    "grid",
    "splat",
    "depth",
    "note"
   ],
   "properties": {
    "cube_mm": {
     "$ref": "#/$defs/triple"
    },
    "axes": {
     "type": "object",
     "required": [
      "z"
     ],
     "properties": {
      "z": {
       "$ref": "#/$defs/lattice_axis"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     },
     "additionalProperties": false
    },
    "coords_rounding_mm": {
     "type": "number"
    },
    "origin_mm": {
     "$ref": "#/$defs/triple"
    },
    "grid": {
     "type": "object",
     "required": [
      "x0",
      "y0",
      "z0",
      "pitch_mm",
      "pitch_z_mm",
      "n",
      "z_axis"
     ],
     "properties": {
      "x0": {
       "type": "number"
      },
      "y0": {
       "type": "number"
      },
      "z0": {
       "type": "null"
      },
      "pitch_mm": {
       "type": "number",
       "minimum": 1
      },
      "pitch_z_mm": {
       "type": "number",
       "minimum": 1
      },
      "n": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1
       },
       "minItems": 3,
       "maxItems": 3
      },
      "z_axis": {
       "const": "native_layers"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "splat": {
     "$ref": "#/$defs/splat"
    },
    "depth": {
     "type": "object",
     "required": [
      "policy",
      "note"
     ],
     "properties": {
      "policy": {
       "const": "native_layers"
      },
      "note": {
       "type": "string"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "note": {
     "type": "string"
    }
   },
   "propertyNames": {
    "$ref": "#/$defs/no_raw_keys"
   },
   "additionalProperties": false
  },
  "cubes": {
   "type": "object",
   "required": [
    "n",
    "order",
    "dtype",
    "ix",
    "iy",
    "iz",
    "code",
    "flags",
    "flag_bits",
    "shower_codes"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "order": {
     "const": "ascending energy"
    },
    "dtype": {
     "type": "object",
     "required": [
      "ix",
      "iy",
      "iz",
      "code",
      "flags"
     ],
     "properties": {
      "ix": {
       "enum": [
        "u8",
        "u16le"
       ]
      },
      "iy": {
       "enum": [
        "u8",
        "u16le"
       ]
      },
      "iz": {
       "enum": [
        "u8",
        "u16le"
       ]
      },
      "code": {
       "const": "u8"
      },
      "flags": {
       "const": "u8"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     },
     "additionalProperties": false
    },
    "ix": {
     "type": "string"
    },
    "iy": {
     "type": "string"
    },
    "iz": {
     "type": "string"
    },
    "code": {
     "type": "string"
    },
    "flags": {
     "type": "string"
    },
    "flag_bits": {
     "type": "object",
     "required": [
      "shower",
      "primary",
      "below_floor"
     ],
     "properties": {
      "shower": {
       "const": [
        0,
        1
       ]
      },
      "primary": {
       "const": 2
      },
      "below_floor": {
       "const": 3
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw_keys"
     }
    },
    "shower_codes": {
