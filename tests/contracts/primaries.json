{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/primaries (C11)",
 "type": "object",
 "required": [
  "definition",
  "overall",
  "by_bin",
  "primary_count",
  "notes",
  "filter"
 ],
 "properties": {
  "definition": {
   "type": "string"
  },
  "overall": {
   "type": "object",
   "required": [
    "n_events",
    "n_no_primary",
    "fraction",
    "interval"
   ],
   "properties": {
    "n_events": {
     "type": "integer"
    },
    "n_no_primary": {
     "type": "integer"
    },
    "fraction": {
     "type": [
      "number",
      "null"
     ]
    },
    "interval": {
     "anyOf": [
      {
       "$ref": "#/$defs/interval"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "by_bin": {
   "type": "object",
   "required": [
    "bin",
    "label",
    "n",
    "k",
    "fraction",
    "lo",
    "hi"
   ],
   "properties": {
    "bin": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "label": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "n": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "k": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "fraction": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "lo": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "hi": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    }
   }
  },
  "primary_count": {
   "type": "object",
   "required": [
    "value",
    "events",
    "top_bucket"
   ],
   "properties": {
    "value": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "events": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "top_bucket": {
     "type": "string"
    }
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object"
  }
 }
}
