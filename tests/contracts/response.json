{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/response (B1, B2, resolution)",
 "type": "object",
 "required": [
  "meta",
  "kind",
  "unit",
  "calibration",
  "b1",
  "b2",
  "resolution",
  "notes",
  "filter"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "kind": {
   "type": "string"
  },
  "unit": {
   "const": "%"
  },
  "calibration": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "c",
     "sampling_fraction_pct",
     "ci95",
     "se",
     "n",
     "method",
     "label"
    ],
    "properties": {
     "c": {
      "type": [
       "number",
       "null"
      ],
      "description": "Σ incident momentum / Σ deposited energy over the whole selection (sum before divide), fitted once per shower."
     },
     "sampling_fraction_pct": {
      "type": [
       "number",
       "null"
      ],
      "description": "100 Σ E_dep / Σ p, the sampling fraction c implies, in percent."
     },
     "ci95": {
      "anyOf": [
       {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        },
        "minItems": 2,
        "maxItems": 2
       },
       {
        "type": "null"
       }
      ],
      "description": "95% Student-t interval of c (linearised ratio, events as clusters); not clipped."
     },
     "se": {
      "type": [
       "number",
       "null"
      ],
      "description": "Standard error of c."
     },
     "n": {
      "type": "integer",
      "description": "Events (clusters) the ratio was taken over."
     },
     "method": {
      "type": "string"
     },
     "label": {
      "type": "string"
     }
    }
   }
  },
  "b1": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "axis",
    "series",
    "whisker",
    "dispersion"
   ],
   "properties": {
    "axis": {
     "type": "object",
     "required": [
      "lo",
      "hi",
      "interval",
      "unit",
      "bins",
      "hist_centres",
      "clipping",
      "provisional"
     ],
     "properties": {
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "unit": {
       "type": "string"
      },
      "bins": {
       "type": "integer"
      },
      "hist_centres": {
       "type": "array",
       "items": {
        "type": "number"
       }
      },
      "clipping": {
       "$ref": "#/$defs/clipping"
      },
      "provisional": {
       "type": "boolean"
      }
     }
    },
    "series": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "n",
       "n_dropped",
       "draw",
       "histogram",
       "strip",
       "fit",
       "markers",
       "reference",
       "message",
       "n_absent"
      ],
      "properties": {
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "n": {
        "type": "integer"
       },
       "n_dropped": {
        "type": "integer",
        "description": "Present events dropped for a non-finite or negative deposit, or a non-positive momentum."
       },
       "draw": {
        "enum": [
         "histogram",
         "strip",
         "none"
        ]
       },
       "histogram": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "density",
         "n_in_range",
         "n_below",
         "n_above"
        ],
        "properties": {
         "density": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "description": "Counts / (N × bin width) over all N events of the series, per percent: the bars' area is the fraction of events inside the axis."
         },
         "n_in_range": {
          "type": "integer"
         },
         "n_below": {
          "type": "integer"
         },
         "n_above": {
          "type": "integer"
         }
        }
       },
       "strip": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "values",
         "n_shown",
         "truncated"
        ],
        "properties": {
         "values": {
          "type": "array",
          "items": {
           "type": "number"
          }
         },
         "n_shown": {
          "type": "integer"
         },
         "truncated": {
          "type": "boolean"
         }
        }
       },
       "fit": {
        "type": "object",
        "description": "Plain sample moments (ddof = 1) of all events of the series; no core refit.",
        "required": [
         "n",
         "mu",
         "sigma",
         "sigma_population",
         "mu_error",
         "sigma_error",
         "mu_ci95",
         "sigma_ci95",
         "sigma_bias_factor",
         "sigma_robust",
         "non_gaussian",
         "shape_testable",
         "estimator",
         "moments_subset"
        ],
        "properties": {
         "n": {
          "type": "integer"
         },
         "mu": {
          "type": [
           "number",
           "null"
          ]
         },
         "sigma": {
          "type": [
           "number",
           "null"
          ]
         },
         "sigma_population": {
          "type": [
           "number",
           "null"
          ]
         },
         "mu_error": {
          "type": [
           "number",
           "null"
          ]
         },
         "sigma_error": {
          "type": [
           "number",
           "null"
          ]
         },
         "mu_ci95": {
          "anyOf": [
           {
            "type": "array",
            "items": {
             "type": [
              "number",
              "null"
             ]
            },
            "minItems": 2,
            "maxItems": 2
           },
           {
            "type": "null"
           }
          ]
         },
         "sigma_ci95": {
          "anyOf": [
           {
            "type": "array",
            "items": {
             "type": [
              "number",
              "null"
             ]
            },
            "minItems": 2,
            "maxItems": 2
           },
           {
            "type": "null"
           }
          ]
         },
         "sigma_bias_factor": {
          "type": [
           "number",
           "null"
          ]
         },
         "sigma_robust": {
          "type": [
           "number",
           "null"
          ]
         },
         "non_gaussian": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "shape_testable": {
          "type": "boolean"
         },
         "estimator": {
          "enum": [
           "none",
           "mean_only",
           "moments_1dof",
           "moments",
           "degenerate"
          ]
         },
         "moments_subset": {
          "type": "string"
         }
        }
       },
       "markers": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "mu",
         "ci95_lo",
         "ci95_hi",
         "dispersion_lo",
         "dispersion_hi"
        ],
        "properties": {
         "mu": {
          "type": [
           "number",
           "null"
          ]
         },
         "ci95_lo": {
          "type": [
           "number",
           "null"
          ]
         },
         "ci95_hi": {
          "type": [
           "number",
           "null"
          ]
         },
         "dispersion_lo": {
          "type": [
           "number",
           "null"
          ]
         },
         "dispersion_hi": {
          "type": [
           "number",
           "null"
          ]
         }
        },
        "description": "The mean of the per-event fractions: ci95 is the capped 95% Student-t interval of the mean, dispersion the uncapped ± sample SD band. Null below N = 2."
       },
       "reference": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "value",
         "ci95_lo",
         "ci95_hi",
         "label"
        ],
        "properties": {
         "value": {
          "type": [
           "number",
           "null"
          ]
         },
         "ci95_lo": {
          "type": [
           "number",
           "null"
          ]
         },
         "ci95_hi": {
          "type": [
           "number",
           "null"
          ]
         },
         "label": {
          "type": "string"
         }
        },
        "description": "The ratio of sums 100 Σ E_dep / Σ p with its own 95% Student-t interval: a different estimator from the mean marker."
       },
       "message": {
        "type": [
         "string",
         "null"
        ]
       },
       "n_absent": {
        "type": "integer",
        "description": "Selected events that hold no hit rows of this shower; not part of the series."
       }
      }
     }
    },
    "whisker": {
     "$ref": "#/$defs/whisker"
    },
    "dispersion": {
     "type": "string"
    }
   }
  },
  "b2": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "series",
    "whisker",
    "dispersion",
    "y"
   ],
   "properties": {
    "series": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "bins"
      ],
      "properties": {
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "bins": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "bin",
          "label",
          "lo",
          "hi",
          "n",
          "p_mean",
          "p_sd",
          "mean",
          "sd",
          "ci95",
          "se",
          "dof_note",
          "weak",
          "scaling_factor",
          "ratio_of_sums",
          "sd_se",
          "sd_ci95",
          "c4"
         ],
         "properties": {
          "bin": {
           "type": "integer"
          },
          "label": {
           "type": "string"
          },
          "lo": {
           "type": "number"
          },
          "hi": {
           "type": [
            "number",
            "null"
           ]
          },
          "n": {
           "type": "integer"
          },
          "p_mean": {
           "type": [
            "number",
            "null"
           ],
           "description": "Mean incident momentum of the bin's events (GeV): the x position."
          },
          "p_sd": {
           "type": [
            "number",
            "null"
           ]
          },
          "mean": {
           "type": [
            "number",
            "null"
           ]
          },
          "sd": {
           "type": [
            "number",
            "null"
           ],
           "description": "Sample SD (ddof = 1): the uncapped band, √N wider than the whisker."
          },
          "ci95": {
           "anyOf": [
            {
             "type": "array",
             "items": {
              "type": [
               "number",
               "null"
              ]
             },
             "minItems": 2,
             "maxItems": 2
            },
            {
             "type": "null"
            }
           ],
           "description": "95% Student-t interval of the mean at every N; null below N = 2; not clipped."
          },
          "se": {
           "type": [
            "number",
            "null"
           ]
          },
          "dof_note": {
           "type": [
            "string",
            "null"
           ]
          },
          "weak": {
           "type": "boolean",
           "description": "N < 20."
          },
          "scaling_factor": {
           "type": [
            "number",
            "null"
           ],
           "description": "The notebook's 1 / mean of the per-event fractions."
          },
          "ratio_of_sums": {
           "type": "object",
           "required": [
            "value",
            "ci95"
           ],
           "properties": {
            "value": {
             "type": [
              "number",
              "null"
             ]
            },
            "ci95": {
             "anyOf": [
              {
               "type": "array",
               "items": {
                "type": [
                 "number",
                 "null"
                ]
               },
               "minItems": 2,
               "maxItems": 2
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "description": "100 Σ E_dep / Σ p of the bin with its interval; tooltip only, never calibrates."
          },
          "sd_se": {
           "type": [
            "number",
            "null"
           ],
           "description": "Standard error of the SD, σ / √(2 (N − 1))."
          },
          "sd_ci95": {
           "anyOf": [
            {
             "type": "array",
             "items": {
              "type": [
               "number",
               "null"
              ]
             },
             "minItems": 2,
             "maxItems": 2
            },
            {
             "type": "null"
            }
           ],
           "description": "Asymmetric 95% χ² interval of the SD, in percent."
          },
          "c4": {
           "type": [
            "number",
            "null"
           ],
           "description": "Bias factor E[s]/σ of the SD, quoted for 2 ≤ N < 15 only."
          }
         }
        }
       }
      }
     }
    },
    "whisker": {
     "$ref": "#/$defs/whisker"
    },
    "dispersion": {
     "type": "string"
    },
    "y": {
     "type": "object",
     "required": [
      "zero_based",
      "lo",
      "hi",
      "interval",
      "provisional",
      "n_clipped"
     ],
     "properties": {
      "zero_based": {
       "type": "boolean"
      },
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "provisional": {
       "type": "boolean"
      },
      "n_clipped": {
       "type": "integer",
       "description": "Bins drawing a mark (point, band or whisker) beyond [lo, hi], clipped or cut at zero, not rescaled."
      }
     }
    }
   }
  },
  "resolution": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "series",
    "whisker",
    "y",
    "note",
    "value_unit"
   ],
   "properties": {
    "series": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "kind",
       "unit",
       "bins"
      ],
      "properties": {
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "calibrated_energy",
         "response_ratio"
        ]
       },
       "unit": {
        "type": "string",
        "description": "Unit of mu, sigma and sigma_ci95: GeV for the calibrated energy, % for the response ratio."
       },
       "bins": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "bin",
          "label",
          "n",
          "p_mean",
          "mu",
          "sigma",
          "sigma_ci95",
          "value",
          "ci95",
          "se_delta",
          "c4",
          "non_gaussian",
          "momentum_spread",
          "weak",
          "sigma_se"
         ],
         "properties": {
          "bin": {
           "type": "integer"
          },
          "label": {
           "type": "string"
          },
          "n": {
           "type": "integer"
          },
          "p_mean": {
           "type": [
            "number",
            "null"
           ]
          },
          "mu": {
           "type": [
            "number",
            "null"
           ],
           "description": "Mean of the series' quantity, in the series unit."
          },
          "sigma": {
           "type": [
            "number",
            "null"
           ],
           "description": "Unbiased (ddof = 1) width, in the series unit."
          },
          "sigma_ci95": {
           "anyOf": [
            {
             "type": "array",
             "items": {
              "type": [
               "number",
               "null"
              ]
             },
             "minItems": 2,
             "maxItems": 2
            },
            {
             "type": "null"
            }
           ],
           "description": "95% χ² interval of σ alone, in the series unit; μ's uncertainty is not in it."
          },
          "value": {
           "type": [
            "number",
            "null"
           ],
           "description": "σ/μ in percent."
          },
          "ci95": {
           "anyOf": [
            {
             "type": "array",
             "items": {
              "type": [
               "number",
               "null"
              ]
             },
             "minItems": 2,
             "maxItems": 2
            },
            {
             "type": "null"
            }
           ],
           "description": "The whisker: 95% Student-t interval on the delta-method SE of σ/μ, in percent; symmetric, not clipped, and can cross zero at small N."
          },
          "se_delta": {
           "type": [
            "number",
            "null"
           ],
           "description": "Delta-method standard error of σ/μ in percent; includes μ's uncertainty."
          },
          "c4": {
           "type": [
            "number",
            "null"
           ],
           "description": "Bias factor E[s]/σ, quoted for 2 ≤ N < 15 only."
          },
          "non_gaussian": {
           "type": [
            "boolean",
            "null"
           ],
           "description": "Gaussian-shape verdict; null (untestable) below N = 20."
          },
          "momentum_spread": {
           "type": [
            "number",
            "null"
           ],
           "description": "σ_p/⟨p⟩ of the bin's events in percent."
          },
          "weak": {
           "type": "boolean"
          },
          "sigma_se": {
           "type": [
            "number",
            "null"
           ],
           "description": "Standard error of sigma, in the series unit."
          }
         }
        }
       }
      }
     }
    },
    "whisker": {
     "$ref": "#/$defs/whisker"
    },
    "y": {
     "type": "object",
     "required": [
      "zero_based",
      "lo",
      "hi",
      "interval",
      "provisional",
      "n_clipped"
     ],
     "properties": {
      "zero_based": {
       "type": "boolean"
      },
      "lo": {
       "type": "number"
      },
      "hi": {
       "type": "number"
      },
      "interval": {
       "type": "number"
      },
      "provisional": {
       "type": "boolean"
      },
      "n_clipped": {
       "type": "integer"
      }
     }
    },
    "note": {
     "type": "string"
    },
    "value_unit": {
     "const": "%",
     "description": "Unit of value, ci95, se_delta, momentum_spread and y."
    }
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object"
  },
  "whisker": {
   "type": "object",
   "required": [
    "method",
    "label",
    "level"
   ],
   "properties": {
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "level": {
     "type": "number"
    }
   }
  }
 }
}
