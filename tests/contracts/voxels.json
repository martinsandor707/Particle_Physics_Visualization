{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/voxels (ensemble)",
 "description": "One branch per channel, chosen by meta.channel: each requires what the frontend reads for that channel (the log ramp and rho_ref for density; scale.ref, rho.cam_ref, meta.cam and budget.cam for the attention channels; split_code and diverging for Shap-CAM). Blocks never carry hits or points keys. negative_w is copied from statistics.json, where its shape is frozen.",
 "anyOf": [
  {
   "$ref": "#/$defs/body_density"
  },
  {
   "$ref": "#/$defs/body_gradcam_energy"
  },
  {
   "$ref": "#/$defs/body_shapcam_energy"
  }
 ],
 "$defs": {
  "no_raw": {
   "not": {
    "enum": [
     "hits",
     "points"
    ]
   },
   "description": "No block of the body carries raw hit or point arrays (CLAUDE.md 1.1)."
  },
  "splat": {
   "type": "object",
   "required": [
    "regime",
    "k",
    "k_z",
    "footprint_mm",
    "gapless_k",
    "gapless"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "regime": {
     "enum": [
      "subdeposit3d",
      "subdeposit2d"
     ]
    },
    "k": {
     "type": "integer",
     "minimum": 2
    },
    "k_z": {
     "type": "integer",
     "minimum": 1
    },
    "footprint_mm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "gapless_k": {
     "type": "integer"
    },
    "gapless": {
     "type": "boolean"
    },
    "budget_rows": {
     "type": "integer"
    }
   }
  },
  "depth": {
   "type": "object",
   "required": [
    "policy",
    "text",
    "pitch_mm",
    "n"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "policy": {
     "enum": [
      "uniform_bins",
      "native_layers"
     ]
    },
    "text": {
     "type": "string"
    },
    "pitch_mm": {
     "type": "number"
    },
    "n": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "frame_local": {
   "type": "object",
   "required": [
    "kind",
    "symbols",
    "n_events",
    "n_showers",
    "provisional",
    "splat",
    "coordinates",
    "comb",
    "n_selected",
    "n_excluded_no_frame",
    "n_label",
    "anchor",
    "depth",
    "comb_source",
    "n_ill_conditioned",
    "ill_conditioned_threshold_mm",
    "anchor_residual",
    "negative_w"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "kind": {
     "const": "local"
    },
    "title": {
     "type": "string"
    },
    "symbols": {
     "type": "object"
    },
    "n_events": {
     "type": "integer",
     "minimum": 0
    },
    "n_selected": {
     "type": "integer",
     "minimum": 0
    },
    "n_excluded_no_frame": {
     "type": "integer",
     "minimum": 0
    },
    "n_showers": {
     "type": "integer",
     "minimum": 0
    },
    "provisional": {
     "type": "boolean"
    },
    "n_label": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchor": {
     "const": "own_shower_entry_point"
    },
    "n_ill_conditioned": {
     "type": "null"
    },
    "ill_conditioned_threshold_mm": {
     "type": "null"
    },
    "anchor_residual": {
     "type": "null"
    },
    "splat": {
     "$ref": "#/$defs/splat"
    },
    "depth": {
     "$ref": "#/$defs/depth"
    },
    "coordinates": {
     "enum": [
      "file",
      "computed"
     ]
    },
    "coordinate_check": {
     "type": [
      "object",
      "null"
     ]
    },
    "comb": {
     "type": [
      "object",
      "null"
     ]
    },
    "comb_source": {
     "type": "string"
    },
    "planned_from": {
     "type": "string"
    },
    "negative_w": {
     "$ref": "#/$defs/negative_w"
    }
   },
   "description": "The Local frame: no rotation from a separation, so no ill-conditioned count or anchor residual; the negative-depth summary of the selection."
  },
  "frame_canonical": {
   "type": "object",
   "required": [
    "kind",
    "symbols",
    "n_events",
    "n_showers",
    "provisional",
    "splat",
    "coordinates",
    "comb",
    "n_selected",
    "n_excluded_no_frame",
    "n_label",
    "anchor",
    "depth",
    "comb_source",
    "n_ill_conditioned",
    "ill_conditioned_threshold_mm",
    "anchor_residual"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "kind": {
     "const": "canonical"
    },
    "title": {
     "type": "string"
    },
    "symbols": {
     "type": "object"
    },
    "n_events": {
     "type": "integer",
     "minimum": 0
    },
    "n_selected": {
     "type": "integer",
     "minimum": 0
    },
    "n_excluded_no_frame": {
     "type": "integer",
     "minimum": 0
    },
    "n_showers": {
     "type": "integer",
     "minimum": 0
    },
    "provisional": {
     "type": "boolean"
    },
    "n_label": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchor": {
     "type": "string"
    },
    "n_ill_conditioned": {
     "type": "integer",
     "minimum": 0
    },
    "ill_conditioned_threshold_mm": {
     "type": "number"
    },
    "anchor_residual": {
     "type": "object"
    },
    "splat": {
     "$ref": "#/$defs/splat"
    },
    "depth": {
     "$ref": "#/$defs/depth"
    },
    "coordinates": {
     "type": "null"
    },
    "coordinate_check": {
     "type": [
      "object",
      "null"
     ]
    },
    "comb": {
     "type": [
      "object",
      "null"
     ]
    },
    "comb_source": {
     "type": "string"
    },
    "planned_from": {
     "type": "string"
    }
   },
   "description": "The D-frame: the events entering closer than the threshold have an effectively random rotation, counted here and stated in the notices.",
   "not": {
    "anyOf": [
     {
      "required": [
       "negative_w"
      ]
     }
    ]
   }
  },
  "frame": {
   "anyOf": [
    {
     "$ref": "#/$defs/frame_local"
    },
    {
     "$ref": "#/$defs/frame_canonical"
    }
   ]
  },
  "grid": {
   "type": "object",
   "required": [
    "pitch_mm",
    "voxel_mm",
    "half_x",
    "half_y",
    "x_centre0",
    "y_centre0",
    "z_centre0",
    "n",
    "alignment",
    "partial_edge",
    "n_fine",
    "z_centres",
    "z_uniform",
    "extent_mm"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "pitch_mm": {
     "type": "number"
    },
    "voxel_mm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "half_x": {
     "type": "number"
    },
    "half_y": {
     "type": "number"
    },
    "x_centre0": {
     "type": "number"
    },
    "y_centre0": {
     "type": "number"
    },
    "z_centre0": {
     "type": "number"
    },
    "n": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": 3,
     "maxItems": 3
    },
    "alignment": {
     "type": "string"
    },
    "partial_edge": {
     "type": "object",
     "required": [
      "x",
      "y",
      "n_voxels",
      "energy_gev",
      "energy_fraction",
      "note"
     ],
     "properties": {
      "x": {
       "type": "boolean"
      },
      "y": {
       "type": "boolean"
      },
      "n_voxels": {
       "type": "integer",
       "minimum": 0
      },
      "energy_gev": {
       "type": "number"
      },
      "energy_fraction": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "note": {
       "type": "string"
      }
     },
     "propertyNames": {
      "$ref": "#/$defs/no_raw"
     }
    },
    "n_fine": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "z_centres": {
     "type": "array",
     "items": {
      "type": "number"
     }
    },
    "z_uniform": {
     "type": "boolean"
    },
    "extent_mm": {
     "type": "object",
     "required": [
      "x",
      "y",
      "z"
     ],
     "properties": {
      "x": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      "y": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      "z": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     }
    }
   }
  },
  "voxels": {
   "type": "object",
   "required": [
    "n",
    "encoding",
    "layer_counts",
    "xy",
    "code",
    "order",
    "dtype",
    "min_code"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "encoding": {
     "const": "layer-run-u8"
    },
    "layer_counts": {
     "type": "string"
    },
    "xy": {
     "type": "string"
    },
    "code": {
     "type": "string"
    },
    "order": {
     "type": "string"
    },
    "dtype": {
     "type": "object",
     "required": [
      "layer_counts",
      "xy",
      "code"
     ],
     "properties": {
      "layer_counts": {
       "const": "u16le"
      },
      "xy": {
       "enum": [
        "u8",
        "u16le"
       ]
      },
      "code": {
       "const": "u8"
      }
     }
    },
    "min_code": {
     "const": 2
    },
    "layout": {
     "type": "string"
    }
   }
  },
  "scale_density": {
   "type": "object",
   "required": [
    "scale",
    "vmin",
    "vmax",
    "decades",
    "floor",
    "floor_ratio",
    "floor_rule",
    "unit",
    "mode",
    "norm",
    "clipped_low",
    "rho_ref",
    "rho_unit"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "scale": {
     "const": "log10"
    },
    "vmin": {
     "type": "number"
    },
    "vmax": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "locked": {
     "type": "boolean"
    },
    "decades": {
     "type": "number"
    },
    "norm": {
     "type": "string"
    },
    "floor": {
     "const": "transparent"
    },
    "floor_ratio": {
     "const": 0.001
    },
    "floor_rule": {
     "type": "string"
    },
    "clipped_low": {
     "type": "integer",
     "minimum": 0
    },
    "rho_ref": {
     "type": [
      "number",
      "null"
     ]
    },
    "rho_unit": {
     "const": "GeV/mm^3/event"
    }
   },
   "description": "Density: log10 of rho_v / rho_ref over three decades.",
   "not": {
    "anyOf": [
     {
      "required": [
       "split_code"
      ]
     },
     {
      "required": [
       "diverging"
      ]
     },
     {
      "required": [
       "ref_name"
      ]
     }
    ]
   }
  },
  "scale_gradcam_energy": {
   "type": "object",
   "required": [
    "scale",
    "vmin",
    "vmax",
    "decades",
    "floor",
    "floor_ratio",
    "floor_rule",
    "unit",
    "mode",
    "norm",
    "clipped_low",
    "quantity",
    "ref",
    "ref_unit",
    "ref_name"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "scale": {
     "const": "log10"
    },
    "vmin": {
     "type": "number"
    },
    "vmax": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "locked": {
     "type": "boolean"
    },
    "decades": {
     "type": "number"
    },
    "norm": {
     "type": "string"
    },
    "floor": {
     "const": "transparent"
    },
    "floor_ratio": {
     "const": 0.001
    },
    "floor_rule": {
     "type": "string"
    },
    "clipped_low": {
     "type": "integer",
     "minimum": 0
    },
    "ref": {
     "type": [
      "number",
      "null"
     ]
    },
    "ref_unit": {
     "const": "GeV/mm^3/event"
    },
    "ref_name": {
     "const": "cam_ref"
    },
    "quantity": {
     "const": "gradcam_energy"
    }
   },
   "description": "Sum E x Grad-CAM: log10 of the value over cam_ref; scale.ref is rho.cam_ref, never the energy rho_ref.",
   "not": {
    "anyOf": [
     {
      "required": [
       "rho_ref"
      ]
     },
     {
      "required": [
       "split_code"
      ]
     },
     {
      "required": [
       "diverging"
      ]
     }
    ]
   }
  },
  "scale_shapcam_energy": {
   "type": "object",
   "required": [
    "scale",
    "vmin",
    "vmax",
    "decades",
    "floor",
    "floor_ratio",
    "floor_rule",
    "unit",
    "mode",
    "norm",
    "clipped_low",
    "quantity",
    "ref",
    "ref_unit",
    "ref_name",
    "split_code",
    "diverging",
    "positive_total",
    "negative_total"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "scale": {
     "const": "signed_log10"
    },
    "vmin": {
     "type": "number"
    },
    "vmax": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "locked": {
     "type": "boolean"
    },
    "decades": {
     "type": "number"
    },
    "norm": {
     "type": "string"
    },
    "floor": {
     "const": "transparent"
    },
    "floor_ratio": {
     "const": 0.001
    },
    "floor_rule": {
     "type": "string"
    },
    "clipped_low": {
     "type": "integer",
     "minimum": 0
    },
    "ref": {
     "type": [
      "number",
      "null"
     ]
    },
    "ref_unit": {
     "const": "GeV/mm^3/event"
    },
    "ref_name": {
     "const": "cam_ref"
    },
    "quantity": {
     "const": "shapcam_energy"
    },
    "split_code": {
     "const": 129
    },
    "diverging": {
     "const": true
    },
    "positive_total": {
     "type": "number"
    },
    "negative_total": {
     "type": "number"
    }
   },
   "description": "Sum E x Shap-CAM, signed: the diverging signed-log ramp, codes below split_code negative.",
   "not": {
    "anyOf": [
     {
      "required": [
       "rho_ref"
      ]
     }
    ]
   }
  },
  "rho_density": {
   "type": "object",
   "required": [
    "rho_ref",
    "unit",
    "basis",
    "floor_ratio",
    "norm",
    "floor",
    "floor_basis",
    "fine_voxel_mm",
    "peak_drawn",
    "provisional"
   ],
   "propertyNames": {
    "$ref": "#/$defs/no_raw"
   },
   "properties": {
    "rho_ref": {
     "type": [
      "number",
      "null"
     ]
    },
    "unit": {
     "const": "GeV/mm^3/event"
    },
    "basis": {
     "type": "string"
    },
    "floor_ratio": {
     "const": 0.001
    },
    "norm": {
     "type": "string"
    },
    "floor": {
