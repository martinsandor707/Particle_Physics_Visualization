     },
     "minItems": 3,
     "maxItems": 3
    },
    "peak_drawn": {
     "type": [
      "number",
      "null"
     ]
    },
    "provisional": {
     "type": "boolean"
    },
    "bound": {
     "type": "string"
    },
    "norm_note": {
     "type": "string"
    },
    "cam_ref": {
     "type": [
      "number",
      "null"
     ]
    },
    "cam_basis": {
     "type": "string"
    },
    "floor_note": {
     "type": "string"
    }
   },
   "description": "Attention channels: the floor is 10^-3 of the channel's own cam_ref; rho_ref stays the energy reference."
  },
  "energy_parts": {
   "type": "object",
   "required": [
    "drawn",
    "below_floor",
