      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "peak_drawn": {
     "type": [
      "number",
      "null"
     ]
    },
    "provisional": {
     "type": "boolean"
    },
    "bound": {
     "type": "string"
    },
    "norm_note": {
     "type": "string"
    }
   },
   "description": "Density: the floor is 10^-3 of the energy rho_ref.",
   "not": {
    "anyOf": [
     {
      "required": [
       "cam_ref"
      ]
     },
     {
      "required": [
       "cam_basis"
      ]
     }
    ]
   }
  },
  "rho_cam": {
   "type": "object",
   "required": [
    "rho_ref",
    "unit",
    "basis",
    "floor_ratio",
    "norm",
    "floor",
    "floor_basis",
    "fine_voxel_mm",
    "peak_drawn",
    "provisional",
