{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/distributions (C4)",
 "type": "object",
 "required": [
  "meta",
  "quantity",
  "edges",
  "series",
  "display",
  "splat",
  "comb",
  "notes",
  "filter",
  "kind",
  "shower"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "quantity": {
   "type": "object",
   "required": [
    "key",
    "label",
    "unit",
    "scale",
    "source",
    "weighting",
    "bin_width",
    "bin_unit"
   ],
   "properties": {
    "key": {
     "enum": [
      "u",
      "v",
      "w",
      "energy",
      "theta",
      "phi",
      "p"
     ]
    },
    "label": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "scale": {
     "enum": [
      "linear",
      "log10"
     ]
    },
    "source": {
     "enum": [
      "hits",
      "showers"
     ]
    },
    "weighting": {
     "type": "string"
    },
    "bin_width": {
     "type": "number",
     "minimum": 0
    },
    "bin_unit": {
     "enum": [
      "mm",
      "decade",
      "rad",
      "GeV"
     ]
    }
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "number"
   }
  },
  "series": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "bin",
     "label",
     "n",
     "offset",
     "counts",
     "below",
     "above",
     "resultant",
     "n_showers",
     "rayleigh_p"
    ],
    "properties": {
     "bin": {
      "type": "integer",
      "minimum": 0
     },
     "label": {
      "type": "string"
     },
     "n": {
      "type": "integer",
      "minimum": 0
     },
     "offset": {
      "type": "integer",
      "minimum": 0
     },
     "counts": {
      "type": "array",
      "items": {
       "type": "number",
       "minimum": 0
      }
     },
     "below": {
      "type": "number",
      "minimum": 0
     },
     "above": {
      "type": "number",
      "minimum": 0
     },
     "resultant": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     },
     "n_showers": {
      "type": "integer",
      "minimum": 0
     },
     "rayleigh_p": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     }
    }
   }
  },
  "display": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "percentiles",
    "n_outside",
    "fraction_outside",
    "note",
    "provisional",
    "coarsened"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "percentiles": {
     "anyOf": [
      {
       "type": "array",
       "items": {
        "type": [
         "number",
         "null"
        ]
       },
       "minItems": 2,
       "maxItems": 2
      },
      {
       "type": "null"
      }
     ]
    },
    "n_outside": {
     "type": "number",
     "minimum": 0
    },
    "fraction_outside": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "note": {
     "type": "string"
    },
    "provisional": {
     "type": "boolean"
    },
    "coarsened": {
     "enum": [
      1,
      2,
      4
     ]
    }
   }
  },
  "splat": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "regime",
    "k",
    "k_z",
    "bin_mm",
    "gap_free",
    "per_hit",
    "footprint_mm"
   ],
   "properties": {
    "regime": {
     "const": "subdeposit3d"
    },
    "k": {
     "type": "integer"
    },
    "k_z": {
     "type": "integer"
    },
    "bin_mm": {
     "type": "number"
    },
    "gap_free": {
     "type": "boolean"
    },
    "per_hit": {
     "type": "integer",
     "minimum": 1
    },
    "footprint_mm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    }
   }
  },
  "comb": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "lag1",
    "combed",
    "measured_on",
    "threshold",
    "axis",
    "k",
    "k_z"
   ],
   "properties": {
    "lag1": {
     "type": [
      "number",
      "null"
     ]
    },
    "combed": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "measured_on": {
     "type": "string"
    },
    "threshold": {
     "type": "number"
    },
    "axis": {
     "enum": [
      "u",
      "v",
      "w"
     ]
    },
    "k": {
     "type": "integer",
     "minimum": 1
    },
    "k_z": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  },
  "kind": {
   "enum": [
    "two_shower_hits",
    "single_shower_hits",
    "single_shower_events"
   ]
  },
  "shower": {
   "enum": [
    "a",
    "b",
    "both"
   ]
  },
  "edges_log10": {
   "type": "array",
   "items": {
    "type": "number"
   }
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object"
  }
 }
}
