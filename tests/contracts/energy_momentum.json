        "number",
        "null"
       ]
      },
      "mu_ci95": {
       "type": [
        "array",
        "null"
       ],
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      "sigma_ci95": {
       "type": [
        "array",
