       "minItems": 2,
       "maxItems": 2
      },
      "estimator": {
       "type": "string"
      },
      "estimator_note": {
       "type": "string"
      },
      "degenerate": {
       "type": "boolean"
      },
      "non_gaussian": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "n_in_range": {
       "type": [
        "integer",
        "null"
