{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/xgboost?view=importance (E5, gain feature importance)",
 "type": "object",
 "required": [
  "meta",
  "run",
  "filtered",
  "selection_note",
  "filter",
  "view",
  "task",
  "features",
  "n_features",
  "n_used",
  "measure",
  "frames",
  "frames_present",
  "interval",
  "notes"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "run": {
   "$ref": "#/$defs/run"
  },
  "filtered": {
   "const": false
  },
  "selection_note": {
   "type": "string"
  },
  "filter": {
   "$ref": "#/$defs/filter"
  },
  "view": {
   "const": "importance"
  },
  "task": {
   "enum": [
    "momentum",
    "angle"
   ]
  },
  "features": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "rank",
     "frame",
     "shipped",
     "raw",
     "folds",
     "fold_mean",
     "fold_sd",
     "fold_t95"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "rank": {
      "type": "integer"
     },
     "frame": {
      "enum": [
       "absolute",
       "trans",
       "local",
       "none"
      ]
     },
     "shipped": {
      "type": [
       "number",
       "null"
      ]
     },
     "raw": {
      "type": "object",
      "required": [
       "gain",
       "weight",
       "cover"
      ],
      "properties": {
       "gain": {
        "type": [
         "number",
         "null"
        ]
       },
       "weight": {
        "type": [
         "number",
         "null"
        ]
       },
       "cover": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     },
     "folds": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 5,
      "maxItems": 5
     },
     "fold_mean": {
      "type": [
       "number",
       "null"
      ]
     },
     "fold_sd": {
      "type": [
       "number",
       "null"
      ]
     },
     "fold_t95": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 2,
      "maxItems": 2
     }
    }
   },
   "minItems": 1
  },
  "n_features": {
   "type": "integer"
  },
  "n_used": {
   "type": "integer"
  },
  "measure": {
   "type": "object",
   "required": [
    "shipped",
    "raw",
    "folds"
   ],
   "properties": {
    "shipped": {
     "type": "string"
    },
    "raw": {
     "type": "string"
    },
    "folds": {
     "type": "string"
    }
   }
  },
  "frames": {
   "type": "object",
   "required": [
    "absolute",
    "trans",
    "local",
    "none"
   ],
   "properties": {
    "absolute": {
     "type": "string"
    },
    "trans": {
     "type": "string"
    },
    "local": {
     "type": "string"
    },
    "none": {
     "type": "string"
    }
   }
  },
  "frames_present": {
   "type": "array",
   "items": {
    "enum": [
     "absolute",
     "trans",
     "local",
     "none"
    ]
   }
  },
  "interval": {
   "type": "object",
   "required": [
    "label",
    "level",
    "dof",
    "t",
    "method",
    "clip"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "level": {
     "type": "number"
    },
    "dof": {
     "type": "integer"
    },
    "t": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "clip": {
     "type": "string"
    }
   }
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  }
 },
 "propertyNames": {
  "not": {
   "enum": [
    "rows",
    "predictions",
    "hits"
   ]
  }
 },
 "$defs": {
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object",
   "required": [
    "table_name",
    "exact",
    "cached",
    "warnings",
    "view",
    "task"
   ],
   "properties": {
    "table_name": {
     "type": "string"
    },
    "exact": {
     "type": "boolean"
    },
    "cached": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "view": {
     "const": "importance"
    },
    "task": {
     "enum": [
      "momentum",
      "angle"
     ]
    }
   }
  },
  "split": {
   "type": "object",
   "required": [
    "reproduced",
    "ratio_42",
    "ratio_others",
    "seeds_others",
    "rule",
    "warning"
   ],
   "properties": {
    "reproduced": {
     "type": "boolean"
    },
    "ratio_42": {
     "type": [
      "number",
      "null"
     ]
    },
    "ratio_others": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "seeds_others": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "rule": {
     "type": "string"
    },
    "warning": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "run": {
   "type": "object",
   "required": [
    "species",
    "seed",
    "task",
    "labels",
    "label_units",
    "model_file",
    "sha256",
    "analysis_version",
    "split",
    "xgboost_version",
    "n_rows",
    "n_train",
    "n_holdout",
    "test_size"
   ],
   "properties": {
    "species": {
     "type": "string"
    },
    "seed": {
     "type": "integer"
    },
    "task": {
     "enum": [
      "momentum",
      "angle"
     ]
    },
    "labels": {
     "type": "array",
     "items": {
      "enum": [
       "momentum",
       "phi",
       "theta"
      ]
     },
     "minItems": 1,
     "maxItems": 2
    },
    "label_units": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "model_file": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    },
    "analysis_version": {
     "type": "integer"
    },
    "split": {
     "$ref": "#/$defs/split"
    },
    "xgboost_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "n_rows": {
     "type": "integer"
    },
    "n_train": {
     "type": "integer"
    },
    "n_holdout": {
     "type": "integer"
    },
    "test_size": {
     "type": "number"
    },
    "archive_increasing": {
     "type": [
      "boolean",
      "null"
     ]
    }
   }
  },
  "summary": {
   "type": "object",
   "required": [
    "mean",
    "sd",
    "se",
    "t95",
    "n",
    "dof",
    "t",
    "clipped"
   ],
   "properties": {
    "mean": {
     "type": [
      "number",
      "null"
     ]
    },
    "sd": {
     "type": [
      "number",
      "null"
     ]
    },
    "se": {
     "type": [
      "number",
      "null"
     ]
    },
    "t95": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "n": {
     "type": "integer"
    },
    "dof": {
     "type": [
      "integer",
      "null"
     ]
    },
    "t": {
     "type": [
      "number",
      "null"
     ]
    },
    "clipped": {
     "type": "boolean"
    }
   }
  },
  "t_interval": {
   "type": "object",
   "required": [
    "label",
    "level",
    "dof",
    "t",
    "method"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "level": {
     "type": "number"
    },
    "dof": {
     "type": "integer"
    },
    "t": {
     "type": "number"
    },
    "method": {
     "type": "string"
    }
   }
  }
 }
}
