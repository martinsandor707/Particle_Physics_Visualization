{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GET /api/statistics (C1, C9)",
 "type": "object",
 "required": [
  "meta",
  "describe",
  "n_events",
  "negative_w",
  "notes",
  "filter"
 ],
 "properties": {
  "meta": {
   "$ref": "#/$defs/meta"
  },
  "describe": {
   "type": "object",
   "required": [
    "coord_system",
    "rows",
    "shifted_row",
    "n_hits",
    "estimator",
    "weighting_note"
   ],
   "properties": {
    "coord_system": {
     "enum": [
      "lab",
      "trans",
      "local"
     ]
    },
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/describe_row"
     }
    },
    "shifted_row": {
     "anyOf": [
      {
       "$ref": "#/$defs/describe_row"
      },
      {
       "type": "null"
      }
     ]
    },
    "estimator": {
     "type": "string"
    },
    "weighting_note": {
     "type": "string"
    },
    "n_hits": {
     "type": "integer",
     "description": "Hits of the selected showers in the selected events, exact (from the event table). A row's count is the number of rows it was computed from: smaller only on a preview sample."
    }
   }
  },
  "n_events": {
   "type": "integer"
  },
  "negative_w": {
   "anyOf": [
    {
     "$ref": "#/$defs/negative_w"
    },
    {
     "type": "null"
    }
   ]
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "filter": {
   "$ref": "#/$defs/filter"
  }
 },
 "$defs": {
  "interval": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "level",
    "method",
    "label"
   ],
   "properties": {
    "lo": {
     "type": [
      "number",
      "null"
     ]
    },
    "hi": {
     "type": [
      "number",
      "null"
     ]
    },
    "level": {
     "type": "number"
    },
    "method": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "filter": {
   "type": "object",
   "required": [
    "e1",
    "e2",
    "d",
    "include_undefined_d"
   ],
   "properties": {
    "e1": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "e2": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "d": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "include_undefined_d": {
     "type": "boolean"
    }
   }
  },
  "clipping": {
   "type": "object",
   "required": [
    "lo",
    "hi",
    "low_percentile",
    "high_percentile",
    "n_total",
    "n_below",
    "n_above",
    "n_outside",
    "fraction_outside",
    "note"
   ],
   "properties": {
    "lo": {
     "type": "number"
    },
    "hi": {
     "type": "number"
    },
    "low_percentile": {
     "type": "number"
    },
    "high_percentile": {
     "type": "number"
    },
    "n_total": {
     "type": "integer"
    },
    "n_below": {
     "type": "integer"
    },
    "n_above": {
     "type": "integer"
    },
    "n_outside": {
     "type": "integer"
    },
    "fraction_outside": {
     "type": "number"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "meta": {
   "type": "object"
  },
  "describe_row": {
   "type": "object",
   "required": [
    "key",
    "label",
    "unit",
    "count",
    "mean",
    "sd",
    "sd_population",
    "min",
    "q25",
    "q50",
    "q75",
    "max",
    "ew_mean",
    "ew_q25",
    "ew_q50",
    "ew_q75"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "count": {
     "type": "integer"
    },
    "mean": {
     "type": [
      "number",
      "null"
     ]
    },
    "sd": {
     "type": [
      "number",
      "null"
     ]
    },
    "sd_population": {
     "type": [
      "number",
      "null"
     ]
    },
    "min": {
     "type": [
      "number",
      "null"
     ]
    },
    "q25": {
     "type": [
      "number",
      "null"
     ]
    },
    "q50": {
     "type": [
      "number",
      "null"
     ]
    },
    "q75": {
     "type": [
      "number",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "null"
     ]
    },
    "ew_mean": {
     "type": [
      "number",
      "null"
     ]
    },
    "ew_q25": {
     "type": [
      "number",
      "null"
     ]
    },
    "ew_q50": {
     "type": [
      "number",
      "null"
     ]
    },
    "ew_q75": {
     "type": [
      "number",
      "null"
     ]
    },
    "display_offset_mm": {
     "type": [
      "number",
      "null"
     ],
     "description": "On the laboratory frame's shifted z row only: the offset subtracted from z."
    },
    "note": {
     "type": "string",
     "description": "Present when N is too small for the numbers to be read at face value."
    }
   }
  },
  "negative_w": {
   "anyOf": [
    {
     "$ref": "#/$defs/negative_w_available"
    },
    {
     "$ref": "#/$defs/negative_w_unavailable"
    }
   ]
  },
  "negative_w_affected": {
   "type": "object",
   "required": [
    "n",
    "mean",
    "sd",
    "min",
    "q25",
    "q50",
    "q75",
    "max",
    "n_over_half"
   ],
   "properties": {
    "n": {
     "type": "integer"
    },
    "mean": {
     "type": [
      "number",
      "null"
     ]
    },
    "sd": {
     "type": [
      "number",
      "null"
     ]
    },
    "min": {
     "type": [
      "number",
      "null"
     ]
    },
    "q25": {
     "type": [
      "number",
      "null"
     ]
    },
    "q50": {
     "type": [
      "number",
      "null"
     ]
    },
    "q75": {
     "type": [
      "number",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "null"
     ]
    },
    "n_over_half": {
     "type": "integer"
    }
   },
   "description": "The notebook's describe() of the per-shower negative-depth hit fraction over the showers that have any: an unweighted mean of per-shower fractions, not the pooled hits_fraction."
  },
  "negative_w_available": {
   "type": "object",
   "required": [
    "available",
    "threshold_mm",
    "unit",
    "showers_per_event",
    "splits",
    "affected",
    "intervals",
    "summary"
   ],
   "properties": {
    "available": {
     "const": true
    },
    "threshold_mm": {
     "type": "number",
     "description": "The depth cut as a magnitude: a hit counts when w < -threshold_mm."
    },
    "unit": {
     "type": "string",
     "description": "What the fractions are over: showers."
    },
    "showers_per_event": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2,
     "description": "How many showers each event contributes to the selection: 2 pools both of a two-shower event, 1 for single-shower data or one chosen shower."
    },
    "summary": {
     "type": "string",
     "description": "One line for the status bar, intervals in brackets, minus signs U+2212."
    },
    "splits": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "n_events",
       "n_showers",
       "events_with_any",
       "events_with_any_ci95",
       "showers_with_any",
       "showers_with_any_ci95",
       "hits",
       "hits_total",
       "hits_fraction",
       "hits_fraction_ci95",
       "energy_gev",
       "energy_total_gev",
       "energy_fraction",
       "energy_fraction_ci95",
       "note"
      ],
      "properties": {
       "key": {
        "enum": [
         "all",
         "low",
         "high",
         "mid"
        ]
       },
       "label": {
        "type": "string"
       },
       "n_events": {
        "type": "integer"
       },
       "n_showers": {
        "type": "integer"
       },
       "events_with_any": {
        "type": "integer"
       },
       "events_with_any_ci95": {
        "anyOf": [
         {
          "type": "array",
          "items": {
           "type": [
            "number",
            "null"
           ]
          },
          "minItems": 2,
          "maxItems": 2
         },
         {
          "type": "null"
         }
        ],
        "description": "Wilson score interval on events: the primary interval for the share with any such hit."
       },
       "showers_with_any": {
        "type": "integer"
       },
       "showers_with_any_ci95": {
        "anyOf": [
         {
          "type": "array",
          "items": {
           "type": [
            "number",
            "null"
           ]
          },
          "minItems": 2,
          "maxItems": 2
         },
         {
          "type": "null"
         }
        ],
        "description": "Wilson score interval on showers: null unless each event contributes one shower (showers_per_event = 1)."
       },
       "hits": {
        "type": "integer",
        "description": "Hits at w < -threshold_mm."
       },
       "hits_fraction": {
        "type": [
         "number",
         "null"
        ]
       },
       "hits_fraction_ci95": {
        "anyOf": [
         {
          "type": "array",
          "items": {
           "type": [
            "number",
            "null"
           ]
          },
          "minItems": 2,
          "maxItems": 2
         },
         {
          "type": "null"
         }
        ]
       },
       "energy_gev": {
        "type": [
         "number",
         "null"
        ],
        "description": "Raw deposited energy of the hits at w < -threshold_mm, in GeV (not calibrated to the incident momentum)."
       },
       "energy_fraction": {
        "type": [
         "number",
         "null"
        ]
       },
       "energy_fraction_ci95": {
        "anyOf": [
         {
          "type": "array",
          "items": {
           "type": [
            "number",
            "null"
           ]
          },
          "minItems": 2,
          "maxItems": 2
         },
         {
          "type": "null"
         }
        ]
       },
       "hits_total": {
        "type": "integer",
        "description": "All hits of the split's showers."
       },
       "energy_total_gev": {
        "type": [
         "number",
         "null"
        ],
        "description": "Raw deposited energy of all hits of the split's showers, in GeV."
       },
       "note": {
        "type": "string",
        "description": "Low-N label of the split's fractions; empty when N is not small."
       }
      }
     },
     "minItems": 4,
     "maxItems": 4
    },
    "affected": {
     "$ref": "#/$defs/negative_w_affected"
    },
    "intervals": {
     "type": "object",
     "required": [
      "hits_fraction",
      "energy_fraction",
      "events_with_any",
      "showers_with_any"
     ],
     "properties": {
      "hits_fraction": {
       "type": "string"
      },
      "energy_fraction": {
       "type": "string"
      },
      "events_with_any": {
       "type": "string"
      },
      "showers_with_any": {
       "type": "string"
      }
     },
     "description": "Which interval each quantity carries, in a few words."
    }
   }
  },
  "negative_w_unavailable": {
   "type": "object",
   "required": [
    "available",
    "reason",
    "threshold_mm",
    "unit",
    "showers_per_event",
    "splits",
    "affected",
    "summary"
   ],
   "properties": {
    "available": {
     "const": false
    },
    "reason": {
     "type": "string",
     "description": "Why the counts cannot be served, e.g. derived tables to rebuild."
    },
    "threshold_mm": {
     "type": "number",
     "description": "The depth cut as a magnitude: a hit counts when w < -threshold_mm."
    },
    "unit": {
     "type": "string",
     "description": "What the fractions are over: showers."
    },
    "showers_per_event": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2,
     "description": "How many showers each event contributes to the selection: 2 pools both of a two-shower event, 1 for single-shower data or one chosen shower."
    },
    "summary": {
     "type": "string",
     "description": "One line for the status bar, intervals in brackets, minus signs U+2212."
    },
    "splits": {
     "type": "array",
     "maxItems": 0
    },
    "affected": {
     "type": "null"
    }
   }
  }
 }
}
